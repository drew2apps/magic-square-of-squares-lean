/-- **For the 150 ratios of `structTable`, among them `627 : 364` and `991 : 263` with the class
`521266`, the class of every solution on the four forms is the one of the table**: that number times
each of the eight products is a Gaussian square. -/
theorem class_of_mem_structTable {e : ℕ × ℕ × List ℕ × ℕ × List ℕ} (he : e ∈ structTable) {u v : ℤ}
    (hcop : IsCoprime u v)
    (h0 : ∃ w, nrm (P0 e.1 e.2.1 u v) = w ^ 2) (h8 : ∃ w, nrm (P8 e.1 e.2.1 u v) = w ^ 2)
    (hL : ∃ w, nrm (PL e.1 e.2.1 u v) = w ^ 2) (hU : ∃ w, nrm (PU e.1 e.2.1 u v) = w ^ 2) :
    ∀ f : Bool × Bool × Bool, GSqP (e.2.2.2.1 : ℤ) (Q e.1 e.2.1 u v f) :=
  class_of_structOk ((List.all_eq_true.mp structTable_ok) e he) hcop h0 h8 hL hU

theorem structTable_length : structTable.length = 150 := by decide +kernel

