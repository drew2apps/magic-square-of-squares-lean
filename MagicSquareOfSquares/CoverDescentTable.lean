/-- **No solution of the five-form system, from a certificate.** -/
theorem no_fullSquares_of_entry {masks : List (ℕ × ℕ × ℕ)} (hmasks : MasksOk masks)
    {e : ℕ × ℕ × List ℕ × List (ℕ × ℕ × ℕ)} (he : entryOk8 masks e = true) (t : ℚ) :
    ¬G1.FullSquares e.1 e.2.1 t := by
  intro h
  obtain ⟨u, V, hV, hcop, h0, _, h8, hL, hU⟩ := G1.exists_coprime_squares_full h
  have hv : (V : ℤ) ≠ 0 := by exact_mod_cast hV.ne'
  have huv : (u : ℤ) + V ≠ 0 := by
    have : (0 : ℤ) < (u : ℤ) + V := by positivity
    exact this.ne'
  refine no_point_of_entry8 hmasks he (Nat.isCoprime_iff_coprime.mpr hcop) hv huv ?_ ?_ ?_ ?_
  · obtain ⟨r, hr⟩ := h0
    exact ⟨r, by dsimp only [nrm, P0]; linear_combination hr⟩
  · obtain ⟨r, hr⟩ := h8
    exact ⟨r, by dsimp only [nrm, P8]; linear_combination hr⟩
  · obtain ⟨r, hr⟩ := hL
    exact ⟨r, by dsimp only [nrm, PL]; linear_combination hr⟩
  · obtain ⟨r, hr⟩ := hU
    exact ⟨r, by dsimp only [nrm, PU]; linear_combination hr⟩

/-- **No solution of the five-form system, from a certificate with four classes.** -/
theorem no_fullSquares_of_entry4 {masks : List (ℕ × ℕ × ℕ)} (hmasks : MasksOk masks)
    {e : ℕ × ℕ × List ℕ × List (ℕ × ℕ)} (he : entryOk4 masks e = true) (t : ℚ) :
    ¬G1.FullSquares e.1 e.2.1 t := by
  intro h
  obtain ⟨u, V, hV, hcop, h0, _, h8, hL, hU⟩ := G1.exists_coprime_squares_full h
  have hv : (V : ℤ) ≠ 0 := by exact_mod_cast hV.ne'
  have huv : (u : ℤ) + V ≠ 0 := by
    have : (0 : ℤ) < (u : ℤ) + V := by positivity
    exact this.ne'
  refine no_point_of_entry4 hmasks he (Nat.isCoprime_iff_coprime.mpr hcop) hv huv ?_ ?_ ?_ ?_
  · obtain ⟨r, hr⟩ := h0
    exact ⟨r, by dsimp only [nrm, P0]; linear_combination hr⟩
  · obtain ⟨r, hr⟩ := h8
    exact ⟨r, by dsimp only [nrm, P8]; linear_combination hr⟩
  · obtain ⟨r, hr⟩ := hL
    exact ⟨r, by dsimp only [nrm, PL]; linear_combination hr⟩
  · obtain ⟨r, hr⟩ := hU
    exact ⟨r, by dsimp only [nrm, PU]; linear_combination hr⟩

/-- **For the ratios of the two tables, no rational `t` makes the five free cells of the G1 family
squares.** Among them are `820 : 799` and `889 : 320`. -/
theorem no_fullSquares_of_mem_ratios {m n : ℕ} (h : (m, n) ∈ ratios) (t : ℚ) :
    ¬G1.FullSquares m n t := by
  rw [← ratios_eq, List.mem_append, List.mem_map, List.mem_map] at h
  rcases h with ⟨e, he, heq⟩ | ⟨e, he, heq⟩
  · have h1 : entryOk8 masks e = true := (List.all_eq_true.mp table_ok) e he
    have h2 := no_fullSquares_of_entry masks_ok h1 t
    rw [Prod.mk.injEq] at heq
    rw [← heq.1, ← heq.2]
    exact h2
  · have h1 : entryOk4 masks e = true := (List.all_eq_true.mp table4_ok) e he
    have h2 := no_fullSquares_of_entry4 masks_ok h1 t
    rw [Prod.mk.injEq] at heq
    rw [← heq.1, ← heq.2]
    exact h2

/-- The pairs of `G1.exceptions1000` that are not in the table. -/
def exceptions : List (ℕ × ℕ) := G1.exceptions1000.filter fun x => decide (x ∉ ratios)

theorem exceptions_length : exceptions.length = 306 := by decide +kernel

/-- **Every pair that is left has `m² + n²` a square or twice a square.** -/
theorem exceptions_degenerate : ∀ x ∈ exceptions,
    Nat.sqrt (x.1 ^ 2 + x.2 ^ 2) ^ 2 = x.1 ^ 2 + x.2 ^ 2 ∨
      2 * Nat.sqrt ((x.1 ^ 2 + x.2 ^ 2) / 2) ^ 2 = x.1 ^ 2 + x.2 ^ 2 := by decide +kernel

end MagicSquareOfSquares.CoverDescent

namespace MagicSquareOfSquares

/-- **In a 3×3 magic square of squares the ratio `(b + d) : (h + f)` of the edge roots is not one
of the ratios of the table of `CoverDescent`.** -/
theorem IsMSS.ratio_ne_of_coverDescent {a b c d e f g h i T : ℤ} (hs : IsMSS a b c d e f g h i T)
    {m n : ℕ} (hn0 : 0 < n) (hmem : (m, n) ∈ CoverDescent.ratios) (hne : h + f ≠ 0) (hbd : b ≠ d) :
    (b + d) * n ≠ (h + f) * m :=
  fun hmn => CoverDescent.no_fullSquares_of_mem_ratios hmem _ (hs.fullSquares hn0 hmn hne hbd)

/-- **In a 3×3 magic square of squares the ratio `(b + d) : (h + f)` of the edge roots is not
`m : n` for any coprime `1 ≤ n < m ≤ 1000` outside the pairs of `CoverDescent.exceptions`.** -/
theorem IsMSS.ratio_ne_of_le_1000_descent {a b c d e f g h i T : ℤ}
    (hs : IsMSS a b c d e f g h i T) {m n : ℕ} (hn0 : 0 < n) (hnm : n < m) (hm : m ≤ 1000)
    (hcop : Nat.Coprime m n) (hex : (m, n) ∉ CoverDescent.exceptions) (hne : h + f ≠ 0)
    (hbd : b ≠ d) : (b + d) * n ≠ (h + f) * m := by
  by_cases hr : (m, n) ∈ CoverDescent.ratios
  · exact hs.ratio_ne_of_coverDescent hn0 hr hne hbd
  · refine hs.ratio_ne_of_le_1000 hn0 hnm hm hcop ?_ hne hbd
    intro hmem
    apply hex
    unfold CoverDescent.exceptions
    rw [List.mem_filter]
    exact ⟨hmem, decide_eq_true hr⟩

/-- **In a 3×3 magic square of squares whose ratio `(b + d) : (h + f)` is `m : n` with coprime
`1 ≤ n < m ≤ 1000`, the number `m² + n²` is a square or twice a square.** -/
theorem IsMSS.ratio_norm_sq_or_two_sq_of_le_1000 {a b c d e f g h i T : ℤ}
    (hs : IsMSS a b c d e f g h i T) {m n : ℕ} (hn0 : 0 < n) (hnm : n < m) (hm : m ≤ 1000)
    (hcop : Nat.Coprime m n) (hne : h + f ≠ 0) (hbd : b ≠ d) (hr : (b + d) * n = (h + f) * m) :
    (∃ k : ℕ, m ^ 2 + n ^ 2 = k ^ 2) ∨ ∃ k : ℕ, m ^ 2 + n ^ 2 = 2 * k ^ 2 := by
  by_contra hcon
  refine hs.ratio_ne_of_le_1000_descent hn0 hnm hm hcop ?_ hne hbd hr
  intro hmem
  have h1 := CoverDescent.exceptions_degenerate (m, n) hmem
  dsimp only at h1
  rcases h1 with h1 | h1
  · exact hcon (Or.inl ⟨_, h1.symm⟩)
  · exact hcon (Or.inr ⟨_, h1.symm⟩)

end MagicSquareOfSquares
