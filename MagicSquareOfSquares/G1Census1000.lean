/-- **In a 3×3 magic square of squares with roots `a b c / d e f / g h i`, the ratio
`(b + d) : (h + f)` of the edge roots is not `m : n` for any coprime `1 ≤ n < m ≤ 1000` outside
the pairs of `G1.exceptions1000`.** -/
theorem IsMSS.ratio_ne_of_le_1000 {a b c d e f g h i T : ℤ} (hs : IsMSS a b c d e f g h i T)
    {m n : ℕ} (hn0 : 0 < n) (hnm : n < m) (hm : m ≤ 1000) (hcop : Nat.Coprime m n)
    (hex : (m, n) ∉ exceptions1000) (hne : h + f ≠ 0) (hbd : b ≠ d) :
    (b + d) * n ≠ (h + f) * m :=
  fun hmn => no_solution_le_1000 hn0 hnm hm hcop hex _ (hs.fullSquares hn0 hmn hne hbd)

end MagicSquareOfSquares
