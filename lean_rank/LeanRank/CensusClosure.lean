  · exact (tau_nonsq (by norm_num) h (N := 30) (k := 5) (Q := 15) (by norm_num) (by norm_num) (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact Or.inr (tau_one (by norm_num) h)
  · exact Or.inr (tau_one (by norm_num) h)
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_nonsq (by norm_num) h (N := 30) (k := 5) (Q := 2) (by norm_num) (by norm_num) (by norm_num)).elim
  · exact (tau_nonsq (by norm_num) h (N := 30) (k := 5) (Q := 2) (by norm_num) (by norm_num) (by norm_num)).elim

/-- **No magic square of squares at the ratio `12 : 5`.** In a 3×3 magic square of the
squares of nine integers `a b c / d e f / g h i` (any signs, magic sum `T`) with
`b² ≠ d²` and `b² ≠ f²`, the edge roots do not satisfy `(b + d) : (h + f) = 12 : 5`. -/
theorem ratio_ne_12_5 {a b c d e f g h i T : ℤ}
    (r₁ : a ^ 2 + b ^ 2 + c ^ 2 = T) (r₂ : d ^ 2 + e ^ 2 + f ^ 2 = T)
    (r₃ : g ^ 2 + h ^ 2 + i ^ 2 = T) (c₁ : a ^ 2 + d ^ 2 + g ^ 2 = T)
    (c₂ : b ^ 2 + e ^ 2 + h ^ 2 = T) (c₃ : c ^ 2 + f ^ 2 + i ^ 2 = T)
    (dg : a ^ 2 + e ^ 2 + i ^ 2 = T) (ad : c ^ 2 + e ^ 2 + g ^ 2 = T)
    (hbd : b ^ 2 ≠ d ^ 2) (hbf : b ^ 2 ≠ f ^ 2) : (b + d) * 5 ≠ (h + f) * 12 := by
  have := ratio_ne_of_tau (m := 12) (n := 5) (by norm_num) (by norm_num)
    (fun τ r0 r8 h0 h8 => tau_12_5 (τ := τ) (r0 := r0) (r8 := r8)
      (by push_cast at h0; linear_combination h0)
      (by push_cast at h8; linear_combination h8))
    r₁ r₂ r₃ c₁ c₂ c₃ dg ad hbd hbf
  exact_mod_cast this

/-! ### `(24, 7)`: `Y² = X(X + 331776)(X + 2401)`, 16 points, reduction modulo 11 -/

instance : (curve (-331776) (-2401)).IsElliptic :=
  LeanRank.RankZeroGen.isElliptic (by decide) (by decide) (by decide)

instance : Fact (Nat.Prime 11) := ⟨by norm_num⟩

instance : (redCurve (intPrime 11) (W₀ 331776 2401)).IsElliptic :=
  redCurve_isElliptic 11 331776 2401 (by norm_num)

/-- `Y² = X³ + 334177X² + 796594176X` modulo `11`. -/
def Ep_24_7 : WeierstrassCurve (ZMod 11) := ⟨0, 8, 0, 4, 0⟩

theorem base_24_7 :
    (((W₀ 331776 2401).toAffine ⁄ (ZMod 11)) : WeierstrassCurve _).toAffine =
      Ep_24_7.toAffine := by
  ext <;> decide +kernel

/-- The reduction modulo `11` has `16` points. -/
theorem cardp_24_7 : Fintype.card Ep_24_7.toAffine.Point = 16 := by decide +kernel

theorem fin_card_le_24_7 :
    Finite (curve (-331776) (-2401)).Point ∧ Nat.card (curve (-331776) (-2401)).Point ≤ 16 :=
  card_le 11 331776 2401 (by norm_num) LeanRank.RankZeroCensus.finrank_24_7 Ep_24_7 base_24_7 cardp_24_7

instance : Finite (curve (-331776) (-2401)).Point := fin_card_le_24_7.1

theorem card_le_24_7 : Nat.card (curve (-331776) (-2401)).Point ≤ 16 := fin_card_le_24_7.2

/-- The 16 points of `Y² = X(X + 331776)(X + 2401)`. -/
noncomputable def pts_24_7 : Fin 16 → (curve (-331776) (-2401)).Point :=
  ![0,
    .some 0 0 (ns (by norm_num)),
    .some (-2401) 0 (ns (by norm_num)),
    .some (-331776) 0 (ns (by norm_num)),
    .some 3024 2343600 (ns (by norm_num)),
    .some 3024 (-2343600) (ns (by norm_num)),
    .some (-5376) 2284800 (ns (by norm_num)),
    .some (-5376) (-2284800) (ns (by norm_num)),
    .some (-28224) 14874048 (ns (by norm_num)),
    .some (-28224) (-14874048) (ns (by norm_num)),
    .some 28224 17640000 (ns (by norm_num)),
    .some 28224 (-17640000) (ns (by norm_num)),
    .some (-148176) 62974800 (ns (by norm_num)),
    .some (-148176) (-62974800) (ns (by norm_num)),
    .some 263424 204153600 (ns (by norm_num)),
    .some 263424 (-204153600) (ns (by norm_num))]

theorem pts_24_7_injective : Function.Injective pts_24_7 := by
  have : Function.Injective (key ∘ pts_24_7) := by decide +kernel
  exact this.of_comp

/-- **`E(ℚ)` is exactly the 16 points `pts_24_7`**, for `E : Y² = X(X + 331776)(X + 2401)`. -/
theorem points_24_7 (P : (curve (-331776) (-2401)).Point) : ∃ i, pts_24_7 i = P :=
  (pts_24_7_injective.bijective_of_nat_card_le (by rw [Nat.card_fin]; exact card_le_24_7)).2 P

theorem card_24_7 : Nat.card (curve (-331776) (-2401)).Point = 16 :=
  le_antisymm card_le_24_7 (by
    have := Nat.card_le_card_of_injective _ pts_24_7_injective
    rwa [Nat.card_fin] at this)

/-- **The affine rational points of `Y² = X(X + 331776)(X + 2401)`.** -/
theorem affine_24_7 {x y : ℚ} (h : y ^ 2 = x * (x + 331776) * (x + 2401)) :
    (x, y) ∈ ([(0, 0), ((-2401), 0), ((-331776), 0), (3024, 2343600), (3024, (-2343600)), ((-5376), 2284800), ((-5376), (-2284800)), ((-28224), 14874048), ((-28224), (-14874048)), (28224, 17640000), (28224, (-17640000)), ((-148176), 62974800), ((-148176), (-62974800)), (263424, 204153600), (263424, (-204153600))] : List (ℚ × ℚ)) := by
  obtain ⟨i, hi⟩ := points_24_7 (.some x y (ns (by push_cast; linear_combination h)))
  have hk := congrArg key hi
  fin_cases i <;> simp [pts_24_7, key] at hk <;> obtain ⟨rfl, rfl⟩ := hk <;> simp

/-- **`576 + 49τ²` and `49 + 576τ²` are both squares of rationals only for `τ ∈ {0, 1, −1}`** (curve `w·f0·f8`, `w = τ²`, of the census pair `(24, 7)`). -/
theorem tau_24_7 {τ r0 r8 : ℚ} (h0 : r0 ^ 2 = 576 + 49 * τ ^ 2)
    (h8 : r8 ^ 2 = 49 + 576 * τ ^ 2) : τ = 0 ∨ τ = 1 ∨ τ = -1 := by
  have hE : (28224 * τ * r0 * r8) ^ 2 =
      (28224 * τ ^ 2) * ((28224 * τ ^ 2) + 331776) * ((28224 * τ ^ 2) + 2401) := by
    have e : (28224 * τ * r0 * r8) ^ 2 = 28224 ^ 2 * τ ^ 2 * r0 ^ 2 * r8 ^ 2 := by ring
    rw [e, h0, h8]; ring
  have hx := affine_24_7 hE
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hx
  rcases hx with ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩
  · exact Or.inl (tau_zero (by norm_num) h)
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_nonsq (by norm_num) h (N := 84) (k := 9) (Q := 28) (by norm_num) (by norm_num) (by norm_num)).elim
  · exact (tau_nonsq (by norm_num) h (N := 84) (k := 9) (Q := 28) (by norm_num) (by norm_num) (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact Or.inr (tau_one (by norm_num) h)
  · exact Or.inr (tau_one (by norm_num) h)
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_nonsq (by norm_num) h (N := 84) (k := 9) (Q := 3) (by norm_num) (by norm_num) (by norm_num)).elim
  · exact (tau_nonsq (by norm_num) h (N := 84) (k := 9) (Q := 3) (by norm_num) (by norm_num) (by norm_num)).elim

/-- **No magic square of squares at the ratio `24 : 7`.** In a 3×3 magic square of the
squares of nine integers `a b c / d e f / g h i` (any signs, magic sum `T`) with
`b² ≠ d²` and `b² ≠ f²`, the edge roots do not satisfy `(b + d) : (h + f) = 24 : 7`. -/
theorem ratio_ne_24_7 {a b c d e f g h i T : ℤ}
    (r₁ : a ^ 2 + b ^ 2 + c ^ 2 = T) (r₂ : d ^ 2 + e ^ 2 + f ^ 2 = T)
    (r₃ : g ^ 2 + h ^ 2 + i ^ 2 = T) (c₁ : a ^ 2 + d ^ 2 + g ^ 2 = T)
    (c₂ : b ^ 2 + e ^ 2 + h ^ 2 = T) (c₃ : c ^ 2 + f ^ 2 + i ^ 2 = T)
    (dg : a ^ 2 + e ^ 2 + i ^ 2 = T) (ad : c ^ 2 + e ^ 2 + g ^ 2 = T)
    (hbd : b ^ 2 ≠ d ^ 2) (hbf : b ^ 2 ≠ f ^ 2) : (b + d) * 7 ≠ (h + f) * 24 := by
  have := ratio_ne_of_tau (m := 24) (n := 7) (by norm_num) (by norm_num)
    (fun τ r0 r8 h0 h8 => tau_24_7 (τ := τ) (r0 := r0) (r8 := r8)
      (by push_cast at h0; linear_combination h0)
      (by push_cast at h8; linear_combination h8))
    r₁ r₂ r₃ c₁ c₂ c₃ dg ad hbd hbf
  exact_mod_cast this

/-! ### Partner ratios -/

/-- **No magic square of squares at the ratio `17 : 7`**, the partner of `12 : 5`
(`ratio_ne_partner`); hypotheses as in `ratio_ne_12_5`. -/
theorem ratio_ne_17_7 {a b c d e f g h i T : ℤ}
    (r₁ : a ^ 2 + b ^ 2 + c ^ 2 = T) (r₂ : d ^ 2 + e ^ 2 + f ^ 2 = T)
    (r₃ : g ^ 2 + h ^ 2 + i ^ 2 = T) (c₁ : a ^ 2 + d ^ 2 + g ^ 2 = T)
    (c₂ : b ^ 2 + e ^ 2 + h ^ 2 = T) (c₃ : c ^ 2 + f ^ 2 + i ^ 2 = T)
    (dg : a ^ 2 + e ^ 2 + i ^ 2 = T) (ad : c ^ 2 + e ^ 2 + g ^ 2 = T)
    (hbd : b ^ 2 ≠ d ^ 2) (hbf : b ^ 2 ≠ f ^ 2) : (b + d) * 7 ≠ (h + f) * 17 := by
  have := ratio_ne_partner (m := 17) (n := 7) (M := 12) (N := 5) (by norm_num) (by norm_num)
    (fun a b c d e f g h i T r₁ r₂ r₃ c₁ c₂ c₃ dg ad hbd hbf => by
      have := ratio_ne_12_5 r₁ r₂ r₃ c₁ c₂ c₃ dg ad hbd hbf
      exact_mod_cast this)
    r₁ r₂ r₃ c₁ c₂ c₃ dg ad hbd hbf
  exact_mod_cast this

/-- **No magic square of squares at the ratio `31 : 17`**, the partner of `24 : 7`
(`ratio_ne_partner`); hypotheses as in `ratio_ne_24_7`. -/
theorem ratio_ne_31_17 {a b c d e f g h i T : ℤ}
    (r₁ : a ^ 2 + b ^ 2 + c ^ 2 = T) (r₂ : d ^ 2 + e ^ 2 + f ^ 2 = T)
    (r₃ : g ^ 2 + h ^ 2 + i ^ 2 = T) (c₁ : a ^ 2 + d ^ 2 + g ^ 2 = T)
    (c₂ : b ^ 2 + e ^ 2 + h ^ 2 = T) (c₃ : c ^ 2 + f ^ 2 + i ^ 2 = T)
    (dg : a ^ 2 + e ^ 2 + i ^ 2 = T) (ad : c ^ 2 + e ^ 2 + g ^ 2 = T)
    (hbd : b ^ 2 ≠ d ^ 2) (hbf : b ^ 2 ≠ f ^ 2) : (b + d) * 17 ≠ (h + f) * 31 := by
  have := ratio_ne_partner (m := 31) (n := 17) (M := 24) (N := 7) (by norm_num) (by norm_num)
    (fun a b c d e f g h i T r₁ r₂ r₃ c₁ c₂ c₃ dg ad hbd hbf => by
      have := ratio_ne_24_7 r₁ r₂ r₃ c₁ c₂ c₃ dg ad hbd hbf
      exact_mod_cast this)
    r₁ r₂ r₃ c₁ c₂ c₃ dg ad hbd hbf
  exact_mod_cast this

