/-- **`16 + 9τ²` and `9 + 16τ²` are both squares of rationals only for `τ ∈ {0, 1, −1}`** (curve `w·f0·f8`, `w = τ²`, of the census pair `(4, 3)`). -/
theorem tau_4_3 {τ r0 r8 : ℚ} (h0 : r0 ^ 2 = 16 + 9 * τ ^ 2)
    (h8 : r8 ^ 2 = 9 + 16 * τ ^ 2) : τ = 0 ∨ τ = 1 ∨ τ = -1 := by
  have hE : (144 * τ * r0 * r8) ^ 2 =
      (144 * τ ^ 2) * ((144 * τ ^ 2) + 256) * ((144 * τ ^ 2) + 81) := by
    have e : (144 * τ * r0 * r8) ^ 2 = 144 ^ 2 * τ ^ 2 * r0 ^ 2 * r8 ^ 2 := by ring
    rw [e, h0, h8]; ring
  have hx := affine_4_3 hE
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hx
  rcases hx with ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩
  · exact Or.inl (tau_zero (by norm_num) h)
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_nonsq (by norm_num) h (N := 6) (k := 2) (Q := 6) (by norm_num) (by norm_num) (by norm_num)).elim
  · exact (tau_nonsq (by norm_num) h (N := 6) (k := 2) (Q := 6) (by norm_num) (by norm_num) (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact Or.inr (tau_one (by norm_num) h)
  · exact Or.inr (tau_one (by norm_num) h)
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_neg (by norm_num) h (by norm_num)).elim
  · exact (tau_nonsq (by norm_num) h (N := 6) (k := 2) (Q := 1) (by norm_num) (by norm_num) (by norm_num)).elim
  · exact (tau_nonsq (by norm_num) h (N := 6) (k := 2) (Q := 1) (by norm_num) (by norm_num) (by norm_num)).elim

/-- **No magic square of squares at the ratio `4 : 3`.** In a 3×3 magic square of the
squares of nine integers `a b c / d e f / g h i` (any signs, magic sum `T`) with
`b² ≠ d²` and `b² ≠ f²`, the edge roots do not satisfy `(b + d) : (h + f) = 4 : 3`. -/
theorem ratio_ne_4_3 {a b c d e f g h i T : ℤ}
    (r₁ : a ^ 2 + b ^ 2 + c ^ 2 = T) (r₂ : d ^ 2 + e ^ 2 + f ^ 2 = T)
    (r₃ : g ^ 2 + h ^ 2 + i ^ 2 = T) (c₁ : a ^ 2 + d ^ 2 + g ^ 2 = T)
    (c₂ : b ^ 2 + e ^ 2 + h ^ 2 = T) (c₃ : c ^ 2 + f ^ 2 + i ^ 2 = T)
    (dg : a ^ 2 + e ^ 2 + i ^ 2 = T) (ad : c ^ 2 + e ^ 2 + g ^ 2 = T)
    (hbd : b ^ 2 ≠ d ^ 2) (hbf : b ^ 2 ≠ f ^ 2) : (b + d) * 3 ≠ (h + f) * 4 := by
  have := ratio_ne_of_tau (m := 4) (n := 3) (by norm_num) (by norm_num)
    (fun τ r0 r8 h0 h8 => tau_4_3 (τ := τ) (r0 := r0) (r8 := r8)
      (by push_cast at h0; linear_combination h0)
      (by push_cast at h8; linear_combination h8))
    r₁ r₂ r₃ c₁ c₂ c₃ dg ad hbd hbf
  exact_mod_cast this

