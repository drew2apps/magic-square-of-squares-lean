import LeanRank.LemmaDEquiv

/-!
# Lemma D reduced to the Mordell–Weil group of one elliptic curve over `ℚ(√2)`

Written by an AI model (Claude, made by Anthropic) on 25 November 2026 (UTC); not read by a person.
Experiment, not counted in the census.

`D2 : w² = f(x) = 2(x² + 1)(x⁴ − 2x³ + 2x² + 2x + 1)` (UNIFORM_RANK.md §4). Over a field `K` with an element
`r`, `r² = 2`, put `d = 2 + r` and

    E1 : Y² = X (X² + 8dX − 8d²).

* `d2_to_E1` (any field `K` with `r² = 2`): `(x, w) ↦ (X, Y) = (4(x² + 1)/(x − 1 + r)², 8w/(x − 1 + r)³)` maps
  `D2` to `E1` (where `x − 1 + r ≠ 0`). Key identity:
  `2f(x) = 2(x² + 1)³ + 4d(x² + 1)²z² − d²(x² + 1)z⁴`, `z = x − 1 + r`, modulo `r² = 2`.
  (This is the composite of the map `(s, Y) ↦ (u, Y)` of UNIFORM_RANK §4, (C1), with `u = (s/ε)²`,
  `s = (x − 1 − r)/(x − 1 + r)`, and the change of model `X = d(u + 1)`.)
* `E1Q2 a b c e`: the point `(a + b√2, c + e√2)` (`a, b, c, e ∈ ℚ`, inside `ℝ`) lies on `E1` over `ℚ(√2)`.
* `E1Points`: the hypothesis that every affine point of `E1(ℚ(√2))` has `X ∈ {0, ±4, ±(12 + 8√2)}`. These are the
  abscissas of the nine affine points of the group of order 10 generated by the images of `(±1, ±4)` and
  `T = (0, 0)` (`E1_points_on`), so `E1Points` says exactly that `E1(ℚ(√2))` is that group of order 10, i.e.
  rank 0 (C2) and torsion of order dividing 10 (C3), which are **not** proved here.
* `lemmaD_of_E1Points : E1Points → LemmaD` (proved): a rational point of `D2` maps to a point of `E1(ℚ(√2))`
  with explicit rational coordinates (`pullback`); comparing the coordinates with the five abscissas leaves
  `x = 1`, `x = −1` and `x = 0`, and `x = 0` needs `w² = 2`.
* Corollaries: `twiceSquareH_of_E1Points`, `rank_family_of_E1Points` (Theorem 2 of UNIFORM_RANK at every
  twice-square ratio with the hypothesis `E1Points` in place of `LemmaD`).
* Controls: `E1_points_on` (the nine affine points are on `E1`; so no abscissa can be dropped from `E1Points`),
  `pullback_one`, `pullback_neg_one` (the images of `(1, ±4)` and `(−1, ±4)`).
-/

namespace MagicSquareOfSquares.Family

/-- `E1 : Y² = X(X² + 8dX − 8d²)` over any field, `d` a parameter (`d = 2 + √2` below). -/
def E1eq {K : Type*} [Field K] (d X Y : K) : Prop :=
  Y ^ 2 = X * (X ^ 2 + 8 * d * X - 8 * d ^ 2)

/-- **The map `D2 → E1`** over any field with `r² = 2`. -/
theorem d2_to_E1 {K : Type*} [Field K] {r x w : K} (hr : r ^ 2 = 2) (hz : x - 1 + r ≠ 0)
    (hw : w ^ 2 = 2 * (x ^ 2 + 1) * (x ^ 4 - 2 * x ^ 3 + 2 * x ^ 2 + 2 * x + 1)) :
    E1eq (2 + r) (4 * (x ^ 2 + 1) / (x - 1 + r) ^ 2) (8 * w / (x - 1 + r) ^ 3) := by
  have key : 2 * w ^ 2 = 2 * (x ^ 2 + 1) ^ 3 + 4 * (2 + r) * (x ^ 2 + 1) ^ 2 * (x - 1 + r) ^ 2
      - (2 + r) ^ 2 * (x ^ 2 + 1) * (x - 1 + r) ^ 4 := by
    linear_combination 2 * hw + (r^4*x^2 + r^4 + 4*r^3*x^3 + 4*r^3*x + 6*r^2*x^4 + 4*r^2*x^3 + 2*r^2*x^2
      + 4*r^2*x - 4*r^2 + 4*r*x^5 + 8*r*x^4 - 8*r*x^3 + 8*r*x^2 - 12*r*x + x^6 + 4*x^5 - 5*x^4 - 5*x^2
      - 4*x + 1) * hr
  generalize x - 1 + r = z at hz key ⊢
  unfold E1eq
  rw [← sub_eq_zero]
  have h : (8 * w / z ^ 3) ^ 2 - 4 * (x ^ 2 + 1) / z ^ 2 * ((4 * (x ^ 2 + 1) / z ^ 2) ^ 2
      + 8 * (2 + r) * (4 * (x ^ 2 + 1) / z ^ 2) - 8 * (2 + r) ^ 2)
      = 32 * (2 * w ^ 2 - (2 * (x ^ 2 + 1) ^ 3 + 4 * (2 + r) * (x ^ 2 + 1) ^ 2 * z ^ 2
      - (2 + r) ^ 2 * (x ^ 2 + 1) * z ^ 4)) / z ^ 6 := by
    field_simp
    ring
  rw [h, key, sub_self, mul_zero, zero_div]

/-- The point `(a + b√2, c + e√2)` (`a, b, c, e` rational) of `E1` over `ℚ(√2) ⊂ ℝ`, `d = 2 + √2`. -/
def E1Q2 (a b c e : ℚ) : Prop :=
  E1eq (2 + √2 : ℝ) ((a : ℝ) + (b : ℝ) * √2) ((c : ℝ) + (e : ℝ) * √2)

/-- **Hypothesis**: the affine points of `E1(ℚ(√2))` have abscissa `0`, `±4` or `±(12 + 8√2)`. Equivalent to
`E1(ℚ(√2))` being the group of order 10 of `E1_points_on` (rank 0 and torsion of order 10; UNIFORM_RANK §4,
(C2)–(C4); not proved in Lean). -/
def E1Points : Prop :=
  ∀ a b c e : ℚ, E1Q2 a b c e →
    (a = 0 ∧ b = 0) ∨ (a = 4 ∧ b = 0) ∨ (a = -4 ∧ b = 0) ∨ (a = 12 ∧ b = 8) ∨ (a = -12 ∧ b = -8)

theorem rat_sq_ne_two (q : ℚ) : q ^ 2 ≠ 2 := by
  intro h
  have h' : (q : ℝ) ^ 2 = 2 := by exact_mod_cast h
  have : √2 = ((|q| : ℚ) : ℝ) := by
    rw [Rat.cast_abs, ← h', Real.sqrt_sq_eq_abs]
  exact irrational_sqrt_two.ne_rat _ this

theorem coords_X {K : Type*} [Field K] {r y : K} (hr : r ^ 2 = 2) (hz : y - 1 + r ≠ 0)
    (hD : (y - 1) ^ 2 - 2 ≠ 0) :
    4 * (y ^ 2 + 1) * ((y - 1) ^ 2 + 2) / ((y - 1) ^ 2 - 2) ^ 2
      + -8 * (y - 1) * (y ^ 2 + 1) / ((y - 1) ^ 2 - 2) ^ 2 * r = 4 * (y ^ 2 + 1) / (y - 1 + r) ^ 2 := by
  have num : (4 * (y ^ 2 + 1) * ((y - 1) ^ 2 + 2) + -8 * (y - 1) * (y ^ 2 + 1) * r) * (y - 1 + r) ^ 2
      - 4 * (y ^ 2 + 1) * ((y - 1) ^ 2 - 2) ^ 2 = 0 := by
    linear_combination (-8*r*y^3 + 8*r*y^2 - 8*r*y + 8*r - 12*y^4 + 24*y^3 - 16*y^2 + 24*y - 4) * hr
  rw [← sub_eq_zero]
  have h : 4 * (y ^ 2 + 1) * ((y - 1) ^ 2 + 2) / ((y - 1) ^ 2 - 2) ^ 2
      + -8 * (y - 1) * (y ^ 2 + 1) / ((y - 1) ^ 2 - 2) ^ 2 * r - 4 * (y ^ 2 + 1) / (y - 1 + r) ^ 2
      = ((4 * (y ^ 2 + 1) * ((y - 1) ^ 2 + 2) + -8 * (y - 1) * (y ^ 2 + 1) * r) * (y - 1 + r) ^ 2
      - 4 * (y ^ 2 + 1) * ((y - 1) ^ 2 - 2) ^ 2) / (((y - 1) ^ 2 - 2) ^ 2 * (y - 1 + r) ^ 2) := by
    field_simp
  rw [h, num, zero_div]

theorem coords_Y {K : Type*} [Field K] {r y w : K} (hr : r ^ 2 = 2) (hz : y - 1 + r ≠ 0)
    (hD : (y - 1) ^ 2 - 2 ≠ 0) :
    8 * (y - 1) * ((y - 1) ^ 2 + 6) * w / ((y - 1) ^ 2 - 2) ^ 3
      + -8 * (3 * (y - 1) ^ 2 + 2) * w / ((y - 1) ^ 2 - 2) ^ 3 * r = 8 * w / (y - 1 + r) ^ 3 := by
  have num : (8 * (y - 1) * ((y - 1) ^ 2 + 6) + -8 * (3 * (y - 1) ^ 2 + 2) * r) * (y - 1 + r) ^ 3
      - 8 * ((y - 1) ^ 2 - 2) ^ 3 = 0 := by
    linear_combination (-24*r^2*y^2 + 48*r^2*y - 40*r^2 - 64*r*y^3 + 192*r*y^2 - 192*r*y + 64*r - 48*y^4
      + 192*y^3 - 240*y^2 + 96*y - 32) * hr
  rw [← sub_eq_zero]
  have h : 8 * (y - 1) * ((y - 1) ^ 2 + 6) * w / ((y - 1) ^ 2 - 2) ^ 3
      + -8 * (3 * (y - 1) ^ 2 + 2) * w / ((y - 1) ^ 2 - 2) ^ 3 * r - 8 * w / (y - 1 + r) ^ 3
      = w * ((8 * (y - 1) * ((y - 1) ^ 2 + 6) + -8 * (3 * (y - 1) ^ 2 + 2) * r) * (y - 1 + r) ^ 3
      - 8 * ((y - 1) ^ 2 - 2) ^ 3) / (((y - 1) ^ 2 - 2) ^ 3 * (y - 1 + r) ^ 3) := by
    field_simp
  rw [h, num, mul_zero, zero_div]

/-- **A rational point of `D2` gives a point of `E1(ℚ(√2))`**, with explicit rational coordinates. -/
theorem pullback {x w : ℚ}
    (hw : w ^ 2 = 2 * (x ^ 2 + 1) * (x ^ 4 - 2 * x ^ 3 + 2 * x ^ 2 + 2 * x + 1)) :
    E1Q2 (4 * (x ^ 2 + 1) * ((x - 1) ^ 2 + 2) / ((x - 1) ^ 2 - 2) ^ 2)
      (-8 * (x - 1) * (x ^ 2 + 1) / ((x - 1) ^ 2 - 2) ^ 2)
      (8 * (x - 1) * ((x - 1) ^ 2 + 6) * w / ((x - 1) ^ 2 - 2) ^ 3)
      (-8 * (3 * (x - 1) ^ 2 + 2) * w / ((x - 1) ^ 2 - 2) ^ 3) := by
  have hr : (√2 : ℝ) ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hDq : (x - 1) ^ 2 - 2 ≠ 0 := sub_ne_zero.mpr (rat_sq_ne_two (x - 1))
  have hD : ((x : ℝ) - 1) ^ 2 - 2 ≠ 0 := by exact_mod_cast hDq
  have hz : (x : ℝ) - 1 + √2 ≠ 0 := by
    intro h
    exact irrational_sqrt_two.ne_rat (1 - x) (by push_cast; linarith)
  have hw' : (w : ℝ) ^ 2 = 2 * ((x : ℝ) ^ 2 + 1) * ((x : ℝ) ^ 4 - 2 * (x : ℝ) ^ 3 + 2 * (x : ℝ) ^ 2
      + 2 * (x : ℝ) + 1) := by exact_mod_cast hw
  unfold E1Q2
  push_cast
  rw [coords_X hr hz hD, coords_Y hr hz hD]
  exact d2_to_E1 hr hz hw'

/-- **Lemma D from `E1Points`.** -/
theorem lemmaD_of_E1Points (hE : E1Points) : LemmaD := by
  intro x w hw
  have hD : (x - 1) ^ 2 - 2 ≠ 0 := sub_ne_zero.mpr (rat_sq_ne_two (x - 1))
  have hD2 : ((x - 1) ^ 2 - 2) ^ 2 ≠ 0 := pow_ne_zero 2 hD
  rcases hE _ _ _ _ (pullback hw) with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ <;>
    rw [div_eq_iff hD2] at h1 h2
  · -- X = 0: impossible, `4(x² + 1)((x − 1)² + 2) > 0`
    rw [zero_mul] at h1
    exact absurd h1 (by positivity)
  · -- X = 4: `x = 1`
    have h : (x - 1) * (x ^ 2 + 1) = 0 := by linear_combination (-1/8 : ℚ) * h2
    rcases mul_eq_zero.1 h with h | h
    · left; linarith
    · exact absurd h (by positivity)
  · -- X = −4: forces `x = 1`, and then the abscissa is `4`
    have h : (x - 1) * (x ^ 2 + 1) = 0 := by linear_combination (-1/8 : ℚ) * h2
    rcases mul_eq_zero.1 h with h | h
    · have hx : x = 1 := by linarith
      subst hx
      norm_num at h1
    · exact absurd h (by positivity)
  · -- X = 12 + 8√2: `x ∈ {0, −1}`, and `x = 0` needs `w² = 2`
    have h : x * (x + 1) * (x ^ 2 - 4 * x + 5) = 0 := by linear_combination (-1/8 : ℚ) * h2
    rcases mul_eq_zero.1 h with h | h
    · rcases mul_eq_zero.1 h with h | h
      · subst h
        norm_num at hw
        exact absurd hw (rat_sq_ne_two w)
      · right; linarith
    · nlinarith [sq_nonneg (x - 2)]
  · -- X = −12 − 8√2: the two coordinate equations have no common solution
    exact absurd (by linear_combination (-x^3/8 + 5*x^2/8 - 11*x/32 - 9/16) * h1
      + (x^3/4 - 7*x^2/8 + 9*x/16 + 29/32) * h2 : (1 : ℚ) = 0) one_ne_zero

/-- With `E1Points`, the twice-square form of Lemma D. -/
theorem twiceSquareH_of_E1Points (hE : E1Points) : TwiceSquareH :=
  twiceSquareH_of_lemmaD (lemmaD_of_E1Points hE)

/-- Theorem 2 of UNIFORM_RANK at every twice-square ratio, with the hypothesis `E1Points`. -/
theorem rank_family_of_E1Points (hE : E1Points) {m n k : ℤ} (hmn : IsCoprime m n)
    (hk : m ^ 2 + n ^ 2 = 2 * k ^ 2) (hne : m ^ 2 ≠ n ^ 2) :
    TwoDescent.Theorem2At (m : ℚ) (n : ℚ) (k : ℚ) ∧ TwoDescent.Theorem2At (m : ℚ) (-(n : ℚ)) (k : ℚ) ∧
      2 ≤ Module.finrank ℤ (TwoDescent.Eplus (m : ℚ) (n : ℚ)).toAffine.Point ∧
      2 ≤ Module.finrank ℤ (TwoDescent.Eplus (m : ℚ) (-(n : ℚ))).toAffine.Point :=
  rank_family_all (lemmaD_of_E1Points hE) hmn hk hne

/-! ### Controls -/

/-- The nine affine points of the group of order 10: `T = (0, 0)`, `(4, ±8√2)`, `(−4, ∓(16 + 8√2))`,
`(12 + 8√2, ±(80 + 56√2))`, `(−12 − 8√2, ∓(32 + 24√2))`. So every abscissa in `E1Points` occurs. -/
theorem E1_points_on :
    E1Q2 0 0 0 0 ∧ E1Q2 4 0 0 8 ∧ E1Q2 4 0 0 (-8) ∧ E1Q2 (-4) 0 (-16) (-8) ∧ E1Q2 (-4) 0 16 8 ∧
      E1Q2 12 8 80 56 ∧ E1Q2 12 8 (-80) (-56) ∧ E1Q2 (-12) (-8) (-32) (-24) ∧ E1Q2 (-12) (-8) 32 24 := by
  have hr : (√2 : ℝ) ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  unfold E1Q2 E1eq
  push_cast
  refine ⟨by ring, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · linear_combination 96 * hr
  · linear_combination 96 * hr
  · linear_combination 32 * hr
  · linear_combination 32 * hr
  · linear_combination (-960 * √2 - 1376) * hr
  · linear_combination (-960 * √2 - 1376) * hr
  · linear_combination (-64 * √2 - 32) * hr
  · linear_combination (-64 * √2 - 32) * hr

/-- The images of `(1, ±4)`: `(4, ±8√2)`. -/
theorem pullback_one (w : ℚ) (hw : w = 4 ∨ w = -4) :
    (4 * ((1:ℚ) ^ 2 + 1) * ((1 - 1) ^ 2 + 2) / ((1 - 1) ^ 2 - 2) ^ 2 = 4) ∧
      (-8 * ((1:ℚ) - 1) * (1 ^ 2 + 1) / ((1 - 1) ^ 2 - 2) ^ 2 = 0) ∧
      (8 * ((1:ℚ) - 1) * ((1 - 1) ^ 2 + 6) * w / ((1 - 1) ^ 2 - 2) ^ 3 = 0) ∧
      (-8 * (3 * ((1:ℚ) - 1) ^ 2 + 2) * w / ((1 - 1) ^ 2 - 2) ^ 3 = 2 * w) := by
  refine ⟨by norm_num, by norm_num, by norm_num, ?_⟩
  rcases hw with rfl | rfl <;> norm_num

/-- The images of `(−1, ±4)`: `(12 + 8√2, ∓(80 + 56√2))`. -/
theorem pullback_neg_one (w : ℚ) :
    (4 * ((-1:ℚ) ^ 2 + 1) * ((-1 - 1) ^ 2 + 2) / ((-1 - 1) ^ 2 - 2) ^ 2 = 12) ∧
      (-8 * ((-1:ℚ) - 1) * ((-1) ^ 2 + 1) / ((-1 - 1) ^ 2 - 2) ^ 2 = 8) ∧
      (8 * ((-1:ℚ) - 1) * ((-1 - 1) ^ 2 + 6) * w / ((-1 - 1) ^ 2 - 2) ^ 3 = -20 * w) ∧
      (-8 * (3 * ((-1:ℚ) - 1) ^ 2 + 2) * w / ((-1 - 1) ^ 2 - 2) ^ 3 = -14 * w) := by
  refine ⟨by norm_num, by norm_num, ?_, ?_⟩ <;> ring

/-! ### `E1(ℚ(√2))[2] = {O, T}` (a piece of (C2)) -/

theorem q2_eq_zero {a b : ℚ} (h : (a : ℝ) + (b : ℝ) * √2 = 0) : a = 0 ∧ b = 0 := by
  by_cases hb : b = 0
  · subst hb
    simp at h
    exact ⟨h, rfl⟩
  · exfalso
    have hb' : (b : ℝ) ≠ 0 := by exact_mod_cast hb
    apply irrational_sqrt_two.ne_rat (-a / b)
    push_cast
    rw [eq_div_iff hb']
    linear_combination h

theorem not_sq_of_irrational {c : ℝ} (hc : Irrational √c) (q : ℚ) : (q : ℝ) ^ 2 ≠ c := by
  intro h
  apply hc.ne_rat |q|
  rw [Rat.cast_abs, ← h, Real.sqrt_sq_eq_abs]

unseal Nat.sqrt.iter in
/-- **`T = (0, 0)` is the only point of order 2 of `E1(ℚ(√2))`**: `X² + 8dX − 8d²` has no root in `ℚ(√2)`
(its roots are `d(−4 ± 2√6)`; for `X = a + b√2` the resultant in `a` of the two coordinate equations is
`8(b² + 8b − 32)(b² + 8b − 8)`, and `√48`, `√24` are irrational). -/
theorem E1_two_torsion (a b : ℚ) (h : E1Q2 a b 0 0) : a = 0 ∧ b = 0 := by
  have hr : (√2 : ℝ) ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  unfold E1Q2 E1eq at h
  push_cast at h
  have hX : ((a : ℝ) + (b : ℝ) * √2) * (((a ^ 2 + 16 * a + 2 * b ^ 2 + 16 * b - 48 : ℚ) : ℝ)
      + ((2 * a * b + 8 * a + 16 * b - 32 : ℚ) : ℝ) * √2) = 0 := by
    push_cast
    linear_combination (-1 : ℝ) * h - (((a : ℝ) + (b : ℝ) * √2) * ((b : ℝ) ^ 2 + 8 * b - 8)) * hr
  rcases mul_eq_zero.1 hX with h0 | h0
  · exact q2_eq_zero h0
  · obtain ⟨hP, hQ⟩ := q2_eq_zero h0
    exfalso
    have hb : (b ^ 2 + 8 * b - 32) * (b ^ 2 + 8 * b - 8) = 0 := by
      linear_combination ((2 * b + 8) ^ 2 / 8) * hP - ((a * (2 * b + 8) + 16 * b + 160) / 8) * hQ
    rcases mul_eq_zero.1 hb with h1 | h1
    · have hq : (((b + 4 : ℚ)) : ℝ) ^ 2 = 48 := by
        have : (b + 4) ^ 2 = 48 := by linear_combination h1
        exact_mod_cast this
      exact not_sq_of_irrational (by decide : Irrational √48) _ hq
    · have hq : (((b + 4 : ℚ)) : ℝ) ^ 2 = 24 := by
        have : (b + 4) ^ 2 = 24 := by linear_combination h1
        exact_mod_cast this
      exact not_sq_of_irrational (by decide : Irrational √24) _ hq

end MagicSquareOfSquares.Family

