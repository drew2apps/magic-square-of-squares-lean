namespace MagicSquareOfSquares.Family.TorsionE1

open WeierstrassCurve WeierstrassCurve.Affine IsDedekindDomain IsDedekindDomain.HeightOneSpectrum

/-- `ℤ[√2]` as Mathlib's quadratic order `ℤ[ω]`, `ω² = 2`. -/
abbrev O := QuadraticAlgebra ℤ 2 0

/-- Its fraction field `ℚ[ω]` (Mathlib's quadratic algebra over `ℚ`). -/
abbrev K' := QuadraticAlgebra ℚ ((2 : ℤ) : ℚ) ((0 : ℤ) : ℚ)

instance : Fact (∀ r : ℚ, r ^ 2 ≠ ((2 : ℤ) : ℚ) + ((0 : ℤ) : ℚ) * r) :=
  ⟨fun r h => rat_sq_ne_two r (by simpa using h)⟩

instance : Fact (¬ IsSquare (QuadraticAlgebra.discr (2 : ℤ) 0)) := ⟨by
  rintro ⟨r, hr⟩
  rw [QuadraticAlgebra.discr_def] at hr
  have h1 : r ≤ 3 := by nlinarith
  have h2 : -3 ≤ r := by nlinarith
  interval_cases r <;> omega⟩

theorem fund8 : Int.IsFundamentalDiscr (QuadraticAlgebra.discr (2 : ℤ) 0) := by
  rw [QuadraticAlgebra.discr_def, show ((0 : ℤ) ^ 2 + 4 * 2) = 4 * 2 by norm_num,
    Int.isFundamentalDiscr_four_mul]
  exact ⟨Int.prime_two.squarefree, Or.inl (by norm_num)⟩

instance : IsIntegralClosure O ℤ K' := QuadraticAlgebra.Int.isIntegralClosure_iff.mpr fund8

instance : Algebra.IsSeparable ℚ K' := Algebra.IsSeparable.of_integral _ _

instance : IsDedekindDomain O := IsIntegralClosure.isDedekindDomain ℤ ℚ K' O

/-! ### `Q2` as the fraction field of `O` -/

theorem s2_mul_s2 : s2 * s2 = 2 := by
  apply (algebraMap Q2 ℝ).injective
  simp only [map_mul, map_ofNat, algebraMap_s2]
  exact Real.mul_self_sqrt (by norm_num)

theorem s2_sq : s2 ^ 2 = 2 := by rw [sq, s2_mul_s2]

/-- `ω ↦ √2`. -/
noncomputable def liftQ2 : O →ₐ[ℤ] Q2 :=
  QuadraticAlgebra.lift ⟨s2, by rw [s2_mul_s2, zero_smul, add_zero, two_zsmul, one_add_one_eq_two]⟩

noncomputable instance algOQ2 : Algebra O Q2 := liftQ2.toRingHom.toAlgebra

theorem algebraMap_O (z : O) : algebraMap O Q2 z = (z.re : Q2) + (z.im : Q2) * s2 := by
  change liftQ2 z = _
  simp [liftQ2, QuadraticAlgebra.lift_apply_apply, zsmul_eq_mul]

theorem algebraMap_O_mk (a b : ℤ) : algebraMap O Q2 ⟨a, b⟩ = (a : Q2) + (b : Q2) * s2 :=
  algebraMap_O _

instance : FaithfulSMul O Q2 := (faithfulSMul_iff_algebraMap_injective O Q2).mpr (by
  rw [injective_iff_map_eq_zero]
  intro z hz
  rw [algebraMap_O] at hz
  have h' := congrArg (algebraMap Q2 ℝ) hz
  simp only [map_add, map_mul, map_intCast, algebraMap_s2, map_zero] at h'
  obtain ⟨h1, h2⟩ := q2_eq_zero (a := z.re) (b := z.im) (by exact_mod_cast h')
  have h1' : z.re = 0 := by exact_mod_cast h1
  have h2' : z.im = 0 := by exact_mod_cast h2
  ext <;> simp [h1', h2'])

theorem adjoin_sqrt2_elem {w : ℝ} (hw : w ∈ Algebra.adjoin ℚ {(√2 : ℝ)}) :
    ∃ p q : ℚ, w = p + q * √2 := by
  induction hw using Algebra.adjoin_induction with
  | mem x hx =>
    rw [Set.mem_singleton_iff] at hx
    exact ⟨0, 1, by simp [hx]⟩
  | algebraMap r => exact ⟨r, 0, by rw [eq_ratCast]; simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨p, q, rfl⟩ := hx
    obtain ⟨p', q', rfl⟩ := hy
    exact ⟨p + p', q + q', by push_cast; ring⟩
  | mul x y _ _ hx hy =>
    obtain ⟨p, q, rfl⟩ := hx
    obtain ⟨p', q', rfl⟩ := hy
    have h2 : √2 * √2 = (2 : ℝ) := Real.mul_self_sqrt (by norm_num)
    exact ⟨p * p' + 2 * q * q', p * q' + q * p', by push_cast; linear_combination (↑q * ↑q' : ℝ) * h2⟩

theorem Q2_elem (z : Q2) : ∃ p q : ℚ, z = (p : Q2) + (q : Q2) * s2 := by
  have hz : (z : ℝ) ∈ Algebra.adjoin ℚ {(√2 : ℝ)} := by
    rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic isIntegral_sqrt_two.isAlgebraic]
    exact z.2
  obtain ⟨p, q, h⟩ := adjoin_sqrt2_elem hz
  refine ⟨p, q, ?_⟩
  apply (algebraMap Q2 ℝ).injective
  simp only [map_add, map_mul, map_ratCast, algebraMap_s2]
  exact h

instance : IsFractionRing O Q2 := IsFractionRing.of_field O Q2 (fun z => by
  obtain ⟨p, q, rfl⟩ := Q2_elem z
  refine ⟨⟨p.num * q.den, q.num * p.den⟩, ((p.den * q.den : ℕ) : O), ?_⟩
  rw [algebraMap_O_mk, map_natCast]
  have hn : ((p.den * q.den : ℕ) : Q2) ≠ 0 := Nat.cast_ne_zero.mpr (by positivity)
  rw [eq_div_iff hn]
  have hp : (p : Q2) * p.den = p.num := by exact_mod_cast congrArg (Rat.cast (K := Q2)) (Rat.mul_den_eq_num p)
  have hq : (q : Q2) * q.den = q.num := by exact_mod_cast congrArg (Rat.cast (K := Q2)) (Rat.mul_den_eq_num q)
  push_cast
  linear_combination (q.den : Q2) * hp + (p.den * s2) * hq)

/-! ### The prime `v = (7, ω − 3)` and its residue field `ZMod 7` -/

/-- `ω ↦ 3` (`3² = 2` in `𝔽₇`). -/
noncomputable def psi7 : O →ₐ[ℤ] ZMod 7 := QuadraticAlgebra.lift ⟨3, by decide⟩

/-- `ω ↦ 10` (`10² = 2` in `ℤ/49`). -/
noncomputable def psi49 : O →ₐ[ℤ] ZMod 49 := QuadraticAlgebra.lift ⟨10, by decide⟩

noncomputable instance algO7 : Algebra O (ZMod 7) := psi7.toRingHom.toAlgebra

theorem algebraMap_O7 (z : O) : algebraMap O (ZMod 7) z = (z.re : ZMod 7) + (z.im : ZMod 7) * 3 := by
  change psi7 z = _
  simp [psi7, QuadraticAlgebra.lift_apply_apply, zsmul_eq_mul]

instance : Fact (Nat.Prime 7) := ⟨by norm_num⟩

theorem surj7 : Function.Surjective (Algebra.ofId O (ZMod 7)) := fun c =>
  ⟨(c.val : O), by rw [Algebra.ofId_apply, map_natCast, ZMod.natCast_zmod_val]⟩

theorem seven_mem : ((7 : ℕ) : O) ∈ RingHom.ker (Algebra.ofId O (ZMod 7)) := by
  rw [RingHom.mem_ker, map_natCast]; decide

theorem seven_ne_zero : ((7 : ℕ) : O) ≠ 0 := by
  intro h
  have := congrArg (algebraMap O Q2) h
  rw [map_natCast, map_zero] at this
  norm_num at this

/-- The height-one prime `v = ker(O → ZMod 7)` above `7`. -/
noncomputable def v7 : HeightOneSpectrum O where
  asIdeal := RingHom.ker (Algebra.ofId O (ZMod 7))
  isPrime := RingHom.ker_isPrime _
  ne_bot := fun h => seven_ne_zero (by rw [← Ideal.mem_bot, ← h]; exact seven_mem)

/-- The residue field of `v` is `ZMod 7`, as an `O`-algebra. -/
noncomputable def sigma7 : (O ⧸ v7.asIdeal) ≃ₐ[O] ZMod 7 :=
  Ideal.quotientKerAlgEquivOfSurjective surj7

noncomputable instance : DecidableEq (O ⧸ v7.asIdeal) := sigma7.toEquiv.decidableEq

theorem cast49 (z : O) :
    algebraMap O (ZMod 7) z = ZMod.castHom (show 7 ∣ 49 by norm_num) (ZMod 7) (psi49 z) := by
  rw [algebraMap_O7]
  simp only [psi49, QuadraticAlgebra.lift_apply_apply, zsmul_eq_mul, map_add, map_mul, map_intCast,
    mul_one]
  congr 1

theorem zmod49_key : ∀ a b : ZMod 49, ZMod.castHom (show 7 ∣ 49 by norm_num) (ZMod 7) a = 0 →
    ZMod.castHom (show 7 ∣ 49 by norm_num) (ZMod 7) b = 0 → a * b = 0 := by decide

/-- `7` is unramified at `v`: `7 ∉ v⁶` (even `7 ∉ v²`). -/
theorem seven_not_mem_pow : ((7 : ℕ) : O) ∉ v7.asIdeal ^ (7 - 1) := by
  intro h
  have h2 : v7.asIdeal ^ (7 - 1) ≤ v7.asIdeal ^ 2 := Ideal.pow_le_pow_right (by norm_num)
  have h3 : v7.asIdeal ^ 2 ≤ RingHom.ker psi49 := by
    rw [pow_two, Ideal.mul_le]
    intro x hx y hy
    rw [RingHom.mem_ker, map_mul]
    have hx' : algebraMap O (ZMod 7) x = 0 := hx
    have hy' : algebraMap O (ZMod 7) y = 0 := hy
    rw [cast49] at hx' hy'
    exact zmod49_key _ _ hx' hy'
  have := h3 (h2 h)
  rw [RingHom.mem_ker, map_natCast] at this
  exact absurd this (by decide)

/-! ### Integral model and good reduction at `v` -/

/-- `y² = x³ + 8(2 + ω)x² − 8(2 + ω)²x` over `O`. -/
def W0 : WeierstrassCurve O := ⟨0, 8 * (2 + QuadraticAlgebra.omega), 0,
  -8 * (2 + QuadraticAlgebra.omega) ^ 2, 0⟩

theorem algebraMap_omega_Q2 : algebraMap O Q2 QuadraticAlgebra.omega = s2 := by
  rw [algebraMap_O]; simp

theorem aO8 : algebraMap O Q2 8 = 8 := by
  rw [algebraMap_O, QuadraticAlgebra.re_ofNat, QuadraticAlgebra.im_ofNat]; push_cast; ring

theorem aO2 : algebraMap O Q2 2 = 2 := by
  rw [algebraMap_O, QuadraticAlgebra.re_ofNat, QuadraticAlgebra.im_ofNat]; push_cast; ring

theorem map_W0 : W0.map (algebraMap O Q2) = E1K := by
  ext <;> simp [W0, E1K, algebraMap_omega_Q2, aO8, aO2]

theorem algebraMap_omega_7 : algebraMap O (ZMod 7) QuadraticAlgebra.omega = 3 := by
  rw [algebraMap_O7]; simp

/-- The reduction `y² = x³ + 5x² + 3x` over `𝔽₇`. -/
def W7 : WeierstrassCurve (ZMod 7) := ⟨0, 5, 0, 3, 0⟩

instance : W7.IsElliptic := by rw [WeierstrassCurve.isElliptic_iff]; decide

theorem baseChange_W0_7 : ((W0.toAffine ⁄ (ZMod 7)) : WeierstrassCurve _).toAffine = W7.toAffine := by
  change W0.map (algebraMap O (ZMod 7)) = W7
  ext <;> simp [W0, W7, algebraMap_omega_7] <;> decide

instance : (redCurve v7 W0).IsElliptic := by
  rw [isElliptic_iff, isUnit_iff_ne_zero]
  change (W0.map (algebraMap O (O ⧸ v7.asIdeal))).Δ ≠ 0
  rw [Ne, map_Δ, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem]
  intro h
  have h' : algebraMap O (ZMod 7) W0.Δ = 0 := h
  rw [← map_Δ] at h'
  have h'' : (W0.map (algebraMap O (ZMod 7))) = W7 := baseChange_W0_7
  rw [h''] at h'
  revert h'; decide


/-! ### The ten points of `E1(ℚ(√2))` and their orders -/

/-- `a + b√2` as the image of `⟨a, b⟩ : O`. -/
noncomputable def q (a b : ℤ) : Q2 := algebraMap O Q2 ⟨a, b⟩

theorem q_eq (a b : ℤ) : q a b = (a : Q2) + (b : Q2) * s2 := algebraMap_O_mk a b

theorem q_ne_zero {c e : ℤ} (h : c ≠ 0 ∨ e ≠ 0) : q c e ≠ 0 := by
  intro h0
  have h1 : (⟨c, e⟩ : O) = 0 := FaithfulSMul.algebraMap_injective O Q2 (h0.trans (map_zero _).symm)
  rcases h with h | h
  · exact h (by simpa using congrArg QuadraticAlgebra.re h1)
  · exact h (by simpa using congrArg QuadraticAlgebra.im h1)

theorem E1K_a₁ : E1K.a₁ = 0 := rfl
theorem E1K_a₂ : E1K.a₂ = 8 * (2 + s2) := rfl
theorem E1K_a₃ : E1K.a₃ = 0 := rfl
theorem E1K_a₄ : E1K.a₄ = -8 * (2 + s2) ^ 2 := rfl
theorem E1K_a₆ : E1K.a₆ = 0 := rfl

theorem E1K_ns {x y : Q2} (h : y ^ 2 = x ^ 3 + 8 * (2 + s2) * x ^ 2 - 8 * (2 + s2) ^ 2 * x) :
    E1K.Nonsingular x y := by
  apply E1K.equation_iff_nonsingular.mp
  rw [WeierstrassCurve.Affine.equation_iff, E1K_a₁, E1K_a₂, E1K_a₃, E1K_a₄, E1K_a₆]
  linear_combination h

/-- Doubling on `E1K` from an explicit slope `L`. -/
theorem double_some {x y x' y' L : Q2} (h : E1K.Nonsingular x y) (h' : E1K.Nonsingular x' y')
    (hy : y ≠ 0) (hL : 3 * x ^ 2 + 2 * (8 * (2 + s2)) * x + -8 * (2 + s2) ^ 2 = (y + y) * L)
    (hx' : L ^ 2 - 8 * (2 + s2) - x - x = x') (hy' : -(L * (x' - x) + y) = y') :
    Point.some x y h + Point.some x y h = Point.some x' y' h' := by
  have hny : y ≠ E1K.negY x y := by
    rw [WeierstrassCurve.Affine.negY, E1K_a₁, E1K_a₃]
    intro hc; apply hy; linear_combination hc / 2
  rw [Point.add_self_of_Y_ne hny, Point.some.injEq]
  have hsl : E1K.slope x x y y = L := by
    rw [slope_of_Y_ne rfl hny, WeierstrassCurve.Affine.negY, E1K_a₁, E1K_a₂, E1K_a₃, E1K_a₄,
      div_eq_iff]
    · linear_combination hL
    · intro hc; apply hy; linear_combination hc / 2
  rw [hsl]
  have hX : E1K.addX x x L = x' := by
    rw [WeierstrassCurve.Affine.addX, E1K_a₁, E1K_a₂]; linear_combination hx'
  refine ⟨hX, ?_⟩
  rw [WeierstrassCurve.Affine.addY, WeierstrassCurve.Affine.negAddY, hX, WeierstrassCurve.Affine.negY,
    E1K_a₁, E1K_a₃]
  linear_combination hy'

theorem neg_some_eq {x y y' : Q2} (h : E1K.Nonsingular x y) (h' : E1K.Nonsingular x y')
    (hy : y' = -y) : -(Point.some x y h) = Point.some x y' h' := by
  rw [Point.neg_some, Point.some.injEq]
  refine ⟨rfl, ?_⟩
  rw [WeierstrassCurve.Affine.negY, E1K_a₁, E1K_a₃, hy]; ring

theorem nsT : E1K.Nonsingular (q 0 0) (q 0 0) := E1K_ns (by simp only [q_eq]; push_cast; ring)
theorem nsA : E1K.Nonsingular (q 4 0) (q 0 8) :=
  E1K_ns (by simp only [q_eq]; push_cast; linear_combination 96 * s2_sq)
theorem nsAm : E1K.Nonsingular (q 4 0) (q 0 (-8)) :=
  E1K_ns (by simp only [q_eq]; push_cast; linear_combination 96 * s2_sq)
theorem nsB : E1K.Nonsingular (q (-4) 0) (q 16 8) :=
  E1K_ns (by simp only [q_eq]; push_cast; linear_combination 32 * s2_sq)
theorem nsBm : E1K.Nonsingular (q (-4) 0) (q (-16) (-8)) :=
  E1K_ns (by simp only [q_eq]; push_cast; linear_combination 32 * s2_sq)
theorem nsC : E1K.Nonsingular (q 12 8) (q 80 56) :=
  E1K_ns (by simp only [q_eq]; push_cast; linear_combination (-960 * s2 - 1376) * s2_sq)
theorem nsCm : E1K.Nonsingular (q 12 8) (q (-80) (-56)) :=
  E1K_ns (by simp only [q_eq]; push_cast; linear_combination (-960 * s2 - 1376) * s2_sq)
theorem nsD : E1K.Nonsingular (q (-12) (-8)) (q (-32) (-24)) :=
  E1K_ns (by simp only [q_eq]; push_cast; linear_combination (-64 * s2 - 32) * s2_sq)
theorem nsDm : E1K.Nonsingular (q (-12) (-8)) (q 32 24) :=
  E1K_ns (by simp only [q_eq]; push_cast; linear_combination (-64 * s2 - 32) * s2_sq)

/-- `T = (0, 0)`. -/
noncomputable def pT : E1K.Point := .some _ _ nsT
/-- `A = (4, 8√2)`, order 5. -/
noncomputable def pA : E1K.Point := .some _ _ nsA
noncomputable def pAm : E1K.Point := .some _ _ nsAm
/-- `B = (−4, 16 + 8√2)`, order 10. -/
noncomputable def pB : E1K.Point := .some _ _ nsB
noncomputable def pBm : E1K.Point := .some _ _ nsBm
/-- `C = (12 + 8√2, 80 + 56√2)`, order 5. -/
noncomputable def pC : E1K.Point := .some _ _ nsC
noncomputable def pCm : E1K.Point := .some _ _ nsCm
/-- `D = (−12 − 8√2, −32 − 24√2)`, order 10 (the generator of v8's report). -/
noncomputable def pD : E1K.Point := .some _ _ nsD
noncomputable def pDm : E1K.Point := .some _ _ nsDm

theorem negA : -pA = pAm := neg_some_eq _ _ (by simp only [q_eq]; push_cast; ring)
theorem negB : -pB = pBm := neg_some_eq _ _ (by simp only [q_eq]; push_cast; ring)
theorem negC : -pC = pCm := neg_some_eq _ _ (by simp only [q_eq]; push_cast; ring)
theorem negD : -pD = pDm := neg_some_eq _ _ (by simp only [q_eq]; push_cast; ring)

/-- `2A = −C`. -/
theorem dblA : pA + pA = pCm := double_some (L := 2 + 4 * s2) nsA nsCm (q_ne_zero (Or.inr (by norm_num)))
  (by simp only [q_eq]; push_cast; linear_combination (-72) * s2_sq)
  (by simp only [q_eq]; push_cast; linear_combination 16 * s2_sq)
  (by simp only [q_eq]; push_cast; linear_combination (-32) * s2_sq)

/-- `2C = A`. -/
theorem dblC : pC + pC = pA := double_some (L := 6 + 2 * s2) nsC nsA (q_ne_zero (Or.inl (by norm_num)))
  (by simp only [q_eq]; push_cast; linear_combination 88 * s2_sq)
  (by simp only [q_eq]; push_cast; linear_combination 4 * s2_sq)
  (by simp only [q_eq]; push_cast; linear_combination 16 * s2_sq)

/-- `2B = A`. -/
theorem dblB : pB + pB = pA := double_some (L := -2 - 2 * s2) nsB nsA (q_ne_zero (Or.inl (by norm_num)))
  (by simp only [q_eq]; push_cast; linear_combination 24 * s2_sq)
  (by simp only [q_eq]; push_cast; linear_combination 4 * s2_sq)
  (by simp only [q_eq]; push_cast; ring)

/-- `2D = C`. -/
theorem dblD : pD + pD = pC := double_some (L := -2) nsD nsC (q_ne_zero (Or.inl (by norm_num)))
  (by simp only [q_eq]; push_cast; linear_combination 56 * s2_sq)
  (by simp only [q_eq]; push_cast; ring)
  (by simp only [q_eq]; push_cast; ring)

theorem dblT : pT + pT = 0 :=
  Point.add_self_of_Y_eq (by rw [WeierstrassCurve.Affine.negY, E1K_a₁, E1K_a₃, q_eq]; push_cast; ring)

theorem five_A : (5 : ℕ) • pA = 0 :=
  calc (5 : ℕ) • pA = pA + (pA + pA) + (pA + pA) := by abel
    _ = pA + pCm + pCm := by rw [dblA]
    _ = pA - (pC + pC) := by rw [← negC]; abel
    _ = 0 := by rw [dblC, sub_self]

theorem five_C : (5 : ℕ) • pC = 0 :=
  calc (5 : ℕ) • pC = pC + (pC + pC) + (pC + pC) := by abel
    _ = pC + (pA + pA) := by rw [dblC]; abel
    _ = 0 := by rw [dblA, ← negC, add_neg_cancel]

theorem ten_B : (10 : ℕ) • pB = 0 :=
  calc (10 : ℕ) • pB = (5 : ℕ) • (pB + pB) := by abel
    _ = 0 := by rw [dblB, five_A]

theorem ten_D : (10 : ℕ) • pD = 0 :=
  calc (10 : ℕ) • pD = (5 : ℕ) • (pD + pD) := by abel
    _ = 0 := by rw [dblD, five_C]

theorem fin_of_nsmul {P : E1K.Point} {n : ℕ} (hn : 0 < n) (h : n • P = 0) : IsOfFinAddOrder P :=
  isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨n, hn, h⟩

theorem tors_T : IsOfFinAddOrder pT := fin_of_nsmul (n := 2) (by norm_num) (by rw [two_nsmul, dblT])
theorem tors_A : IsOfFinAddOrder pA := fin_of_nsmul (by norm_num) five_A
theorem tors_C : IsOfFinAddOrder pC := fin_of_nsmul (by norm_num) five_C
theorem tors_B : IsOfFinAddOrder pB := fin_of_nsmul (by norm_num) ten_B
theorem tors_D : IsOfFinAddOrder pD := fin_of_nsmul (by norm_num) ten_D
theorem tors_Am : IsOfFinAddOrder pAm := negA ▸ tors_A.neg
theorem tors_Bm : IsOfFinAddOrder pBm := negB ▸ tors_B.neg
theorem tors_Cm : IsOfFinAddOrder pCm := negC ▸ tors_C.neg
theorem tors_Dm : IsOfFinAddOrder pDm := negD ▸ tors_D.neg

/-! ### Reduction modulo `v` -/

/-- The points of the reduced curve over `O ⧸ v` transported to `W7` over `ZMod 7`. -/
noncomputable def resPt : (redCurve v7 W0).Point ≃+ W7.toAffine.Point :=
  (Point.mapEquiv (W' := W0.toAffine) sigma7).trans (Point.congr baseChange_W0_7)

theorem sigma_res (o : O) (hx : v7.valuation Q2 (algebraMap O Q2 o) ≤ 1) :
    sigma7 (residueHom v7 (K := Q2) ⟨algebraMap O Q2 o, hx⟩) = algebraMap O (ZMod 7) o := by
  rw [show residueHom v7 (K := Q2) ⟨algebraMap O Q2 o, hx⟩ = Ideal.Quotient.mk v7.asIdeal o from
    residueHom_algebraMap v7 o]
  exact Ideal.quotientKerAlgEquivOfSurjective_mk surj7 o

theorem val_q (a b : ℤ) : v7.valuation Q2 (q a b) ≤ 1 := v7.valuation_le_one _

theorem resPt_red {a b c e : ℤ} (h : E1K.Nonsingular (q a b) (q c e)) {x y : ZMod 7}
    (h' : W7.toAffine.Nonsingular x y) (hx : algebraMap O (ZMod 7) ⟨a, b⟩ = x)
    (hy : algebraMap O (ZMod 7) ⟨c, e⟩ = y) :
    resPt (red v7 map_W0 (.some _ _ h)) = .some x y h' := by
  rw [red_some_of_le v7 map_W0 (val_q a b), resPt, AddEquiv.trans_apply, Point.coe_mapEquiv,
    Point.map_some, Point.congr_some, Point.some.injEq]
  exact ⟨(sigma_res ⟨a, b⟩ _).trans hx, (sigma_res ⟨c, e⟩ _).trans hy⟩

/-- The ten points of `y² = x³ + 5x² + 3x` over `𝔽₇` (O and nine affine points), by `decide`. -/
theorem W7_points : ∀ x y : ZMod 7, W7.toAffine.Equation x y →
    (x = 0 ∧ y = 0) ∨ (x = 4 ∧ y = 3) ∨ (x = 4 ∧ y = 4) ∨ (x = 3 ∧ y = 5) ∨ (x = 3 ∧ y = 2) ∨
    (x = 1 ∧ y = 3) ∨ (x = 1 ∧ y = 4) ∨ (x = 6 ∧ y = 1) ∨ (x = 6 ∧ y = 6) := by decide

/-- **Torsion of `E1(ℚ(√2))`**: every point of finite order is `O` or one of the nine explicit points. -/
theorem torsion_E1K (P : E1K.Point) (hP : IsOfFinAddOrder P) :
    P = 0 ∨ P = pT ∨ P = pA ∨ P = pAm ∨ P = pB ∨ P = pBm ∨ P = pC ∨ P = pCm ∨ P = pD ∨ P = pDm := by
  have key : ∀ Pi : E1K.Point, IsOfFinAddOrder Pi →
      resPt (red v7 map_W0 Pi) = resPt (red v7 map_W0 P) → P = Pi := by
    intro Pi hPi h
    have h1 : red v7 map_W0 P = red v7 map_W0 Pi := (resPt.injective h).symm
    have h0 : red v7 map_W0 (P - Pi) = 0 := by
      have hs := map_sub (redHom v7 map_W0) P Pi
      simp only [coe_redHom] at hs
      rw [hs, h1, sub_self]
    have hfin : IsOfFinAddOrder (P - Pi) := by rw [sub_eq_add_neg]; exact hP.add hPi.neg
    exact sub_eq_zero.mp (eq_zero_of_isOfFinAddOrder_of_red_eq_zero v7 map_W0 (p := 7)
      (by norm_num) seven_mem seven_not_mem_pow hfin h0)
  rcases hq : resPt (red v7 map_W0 P) with _ | ⟨x, y, h⟩
  · exact Or.inl (key 0 (fin_of_nsmul (n := 1) one_pos (nsmul_zero 1))
      (by rw [hq, red_zero, map_zero]; rfl))
  · rcases W7_points x y h.1 with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ |
      ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact Or.inr <| Or.inl <| key _ tors_T (by
        rw [hq]; exact resPt_red nsT h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide))
    · exact Or.inr <| Or.inr <| Or.inl <| key _ tors_A (by
        rw [hq]; exact resPt_red nsA h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide))
    · exact Or.inr <| Or.inr <| Or.inr <| Or.inl <| key _ tors_Am (by
        rw [hq]; exact resPt_red nsAm h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide))
    · exact Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inl <| key _ tors_B (by
        rw [hq]; exact resPt_red nsB h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide))
    · exact Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inl <| key _ tors_Bm (by
        rw [hq]; exact resPt_red nsBm h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide))
    · exact Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inl <| key _ tors_C (by
        rw [hq]; exact resPt_red nsC h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide))
    · exact Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inl <|
        key _ tors_Cm (by
        rw [hq]; exact resPt_red nsCm h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide))
    · exact Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inl <|
        key _ tors_D (by
        rw [hq]; exact resPt_red nsD h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide))
    · exact Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inr <| Or.inr <|
        key _ tors_Dm (by
        rw [hq]; exact resPt_red nsDm h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide))

/-! ### Coordinate form, and the remaining hypothesis of Lemma D -/

theorem some_eq_q {x y : Q2} (h : E1K.Nonsingular x y) {a b c e : ℤ}
    (h' : E1K.Nonsingular (q a b) (q c e)) :
    Point.some x y h = Point.some _ _ h' ↔ x = (a : Q2) + (b : Q2) * s2 ∧ y = (c : Q2) + (e : Q2) * s2 := by
  rw [Point.some.injEq, q_eq, q_eq]

/-- **Torsion of `E1(ℚ(√2))` in coordinates.** An affine point `(x, y)` of
`E1 : y² = x³ + 8(2 + √2)x² − 8(2 + √2)²x` over `ℚ(√2)` has finite order iff it is one of the nine points
below; with `O` these are the ten points of the cyclic group of order 10 generated by `(−12 − 8√2, −32 − 24√2)`. -/
theorem torsion_E1K_iff (x y : Q2) (h : E1K.Nonsingular x y) :
    IsOfFinAddOrder (Point.some x y h) ↔
      (x = 0 ∧ y = 0) ∨ (x = 4 ∧ y = 8 * s2) ∨ (x = 4 ∧ y = -8 * s2) ∨
      (x = -4 ∧ y = 16 + 8 * s2) ∨ (x = -4 ∧ y = -16 - 8 * s2) ∨
      (x = 12 + 8 * s2 ∧ y = 80 + 56 * s2) ∨ (x = 12 + 8 * s2 ∧ y = -80 - 56 * s2) ∨
      (x = -12 - 8 * s2 ∧ y = -32 - 24 * s2) ∨ (x = -12 - 8 * s2 ∧ y = 32 + 24 * s2) := by
  constructor
  · intro hP
    rcases torsion_E1K _ hP with h0 | h0 | h0 | h0 | h0 | h0 | h0 | h0 | h0 | h0
    · exact absurd h0 (Point.some_ne_zero h)
    · obtain ⟨rfl, rfl⟩ := (some_eq_q h nsT).mp h0
      left; constructor <;> push_cast <;> ring
    · obtain ⟨rfl, rfl⟩ := (some_eq_q h nsA).mp h0
      right; left; constructor <;> push_cast <;> ring
    · obtain ⟨rfl, rfl⟩ := (some_eq_q h nsAm).mp h0
      right; right; left; constructor <;> push_cast <;> ring
    · obtain ⟨rfl, rfl⟩ := (some_eq_q h nsB).mp h0
      right; right; right; left; constructor <;> push_cast <;> ring
    · obtain ⟨rfl, rfl⟩ := (some_eq_q h nsBm).mp h0
      right; right; right; right; left; constructor <;> push_cast <;> ring
    · obtain ⟨rfl, rfl⟩ := (some_eq_q h nsC).mp h0
      right; right; right; right; right; left; constructor <;> push_cast <;> ring
    · obtain ⟨rfl, rfl⟩ := (some_eq_q h nsCm).mp h0
      right; right; right; right; right; right; left; constructor <;> push_cast <;> ring
    · obtain ⟨rfl, rfl⟩ := (some_eq_q h nsD).mp h0
      right; right; right; right; right; right; right; left; constructor <;> push_cast <;> ring
    · obtain ⟨rfl, rfl⟩ := (some_eq_q h nsDm).mp h0
      right; right; right; right; right; right; right; right; constructor <;> push_cast <;> ring
  · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ |
      ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
    · exact ((some_eq_q h nsT).mpr (by constructor <;> push_cast <;> ring)) ▸ tors_T
    · exact ((some_eq_q h nsA).mpr (by constructor <;> push_cast <;> ring)) ▸ tors_A
    · exact ((some_eq_q h nsAm).mpr (by constructor <;> push_cast <;> ring)) ▸ tors_Am
    · exact ((some_eq_q h nsB).mpr (by constructor <;> push_cast <;> ring)) ▸ tors_B
    · exact ((some_eq_q h nsBm).mpr (by constructor <;> push_cast <;> ring)) ▸ tors_Bm
    · exact ((some_eq_q h nsC).mpr (by constructor <;> push_cast <;> ring)) ▸ tors_C
    · exact ((some_eq_q h nsCm).mpr (by constructor <;> push_cast <;> ring)) ▸ tors_Cm
    · exact ((some_eq_q h nsD).mpr (by constructor <;> push_cast <;> ring)) ▸ tors_D
    · exact ((some_eq_q h nsDm).mpr (by constructor <;> push_cast <;> ring)) ▸ tors_Dm

/-- **Abscissas of the torsion points** (exactly the hypothesis of `lemmaD_of_torsion` in w1's
`E1RankZero.lean`): an affine point of finite order of `E1K` has `x ∈ {0, ±4, ±(12 + 8√2)}`. -/
theorem torsion_abscissa : ∀ (x y : Q2) (hxy : E1K.Nonsingular x y),
    IsOfFinAddOrder (WeierstrassCurve.Affine.Point.some x y hxy) →
      x = 0 ∨ x = 4 ∨ x = -4 ∨ x = 12 + 8 * s2 ∨ x = -12 - 8 * s2 := by
  intro x y hxy hP
  rcases (torsion_E1K_iff x y hxy).mp hP with ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨rfl, -⟩ |
    ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨rfl, -⟩
  · exact Or.inl rfl
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inr (Or.inl rfl))
  · exact Or.inr (Or.inr (Or.inl rfl))
  · exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))
  · exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr rfl)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr rfl)))

/-- If every point of `E1(ℚ(√2))` has finite order (rank 0), then `E1PointsK`, the hypothesis of
`lemmaD_of_E1PointsK`. -/
theorem E1PointsK_of_torsion (hall : ∀ P : E1K.Point, IsOfFinAddOrder P) : E1PointsK := by
  intro x y hxy
  have hns := E1K.equation_iff_nonsingular.mp hxy
  rcases (torsion_E1K_iff x y hns).mp (hall _) with ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨rfl, -⟩ |
    ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨rfl, -⟩
  · exact Or.inl rfl
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inr (Or.inl rfl))
  · exact Or.inr (Or.inr (Or.inl rfl))
  · exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))
  · exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr rfl)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr rfl)))

/-- **Lemma D from rank 0**: if `E1(ℚ(√2))` is a torsion group, Lemma D holds. -/
theorem lemmaD_of_torsion (hall : ∀ P : E1K.Point, IsOfFinAddOrder P) : LemmaD :=
  lemmaD_of_E1PointsK (E1PointsK_of_torsion hall)

/-- **Lemma D from finiteness of `E1(ℚ(√2))`.** -/
theorem lemmaD_of_finite (hfin : Finite E1K.Point) : LemmaD :=
  lemmaD_of_torsion fun P => isOfFinAddOrder_of_finite P

/-! ### Point count, orders, and the order of the torsion subgroup -/

/-- `#Ẽ(𝔽₇) = 10`, by `decide` on the `Fintype` instance of `EllipticCurves.Mathlib.EllipticCurvePoint`. -/
theorem card_W7 : Fintype.card W7.toAffine.Point = 10 := by decide

/-- The reduction of `E1` at `v` has `10` points over the residue field `O ⧸ v`. -/
theorem natCard_redCurve_v7 : Nat.card (redCurve v7 W0).Point = 10 := by
  rw [Nat.card_congr resPt.toEquiv, Nat.card_eq_fintype_card, card_W7]

/-- The order of every torsion point divides `10` (Stoll's `addOrderOf_dvd_natCard_red` at `v`). -/
theorem addOrderOf_dvd_ten {P : E1K.Point} (hP : IsOfFinAddOrder P) : addOrderOf P ∣ 10 :=
  natCard_redCurve_v7 ▸ addOrderOf_dvd_natCard_red v7 map_W0 (p := 7) (by norm_num) seven_mem
    seven_not_mem_pow hP

/-- Reduction at `v` (followed by `O ⧸ v ≅ ZMod 7`) is injective on torsion points. -/
theorem red_injOn_torsion {P Q : E1K.Point} (hP : IsOfFinAddOrder P) (hQ : IsOfFinAddOrder Q)
    (h : resPt (red v7 map_W0 P) = resPt (red v7 map_W0 Q)) : P = Q := by
  have h1 : red v7 map_W0 P = red v7 map_W0 Q := resPt.injective h
  have h0 : red v7 map_W0 (P - Q) = 0 := by
    have hs := map_sub (redHom v7 map_W0) P Q
    simp only [coe_redHom] at hs
    rw [hs, h1, sub_self]
  have hfin : IsOfFinAddOrder (P - Q) := by rw [sub_eq_add_neg]; exact hP.add hQ.neg
  exact sub_eq_zero.mp (eq_zero_of_isOfFinAddOrder_of_red_eq_zero v7 map_W0 (p := 7)
    (by norm_num) seven_mem seven_not_mem_pow hfin h0)

/-- Every point of `Ẽ(𝔽₇)` is the reduction of one of the ten torsion points. -/
theorem W7_cover (R : W7.toAffine.Point) :
    ∃ P : E1K.Point, IsOfFinAddOrder P ∧ resPt (red v7 map_W0 P) = R := by
  rcases R with _ | ⟨x, y, h⟩
  · exact ⟨0, fin_of_nsmul (n := 1) one_pos (nsmul_zero 1), by rw [red_zero, map_zero]; rfl⟩
  · rcases W7_points x y h.1 with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ |
      ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact ⟨pT, tors_T, resPt_red nsT h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide)⟩
    · exact ⟨pA, tors_A, resPt_red nsA h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide)⟩
    · exact ⟨pAm, tors_Am, resPt_red nsAm h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide)⟩
    · exact ⟨pB, tors_B, resPt_red nsB h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide)⟩
    · exact ⟨pBm, tors_Bm, resPt_red nsBm h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide)⟩
    · exact ⟨pC, tors_C, resPt_red nsC h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide)⟩
    · exact ⟨pCm, tors_Cm, resPt_red nsCm h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide)⟩
    · exact ⟨pD, tors_D, resPt_red nsD h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide)⟩
    · exact ⟨pDm, tors_Dm, resPt_red nsDm h (by rw [algebraMap_O7]; decide) (by rw [algebraMap_O7]; decide)⟩

/-- **The torsion subgroup of `E1(ℚ(√2))` has exactly `10` elements** (reduction at `v` is a bijection from
it onto `Ẽ(𝔽₇)`). -/
theorem card_torsion_E1K : Nat.card {P : E1K.Point // IsOfFinAddOrder P} = 10 := by
  rw [← card_W7, ← Nat.card_eq_fintype_card]
  refine Nat.card_eq_of_bijective (fun P => resPt (red v7 map_W0 P.1))
    ⟨fun P Q h => Subtype.ext (red_injOn_torsion P.2 Q.2 h), fun R => ?_⟩
  obtain ⟨P, hP, hR⟩ := W7_cover R
  exact ⟨⟨P, hP⟩, hR⟩

theorem q_inj_re {a b c e : ℤ} (h : q a b = q c e) : a = c := by
  have h1 : (⟨a, b⟩ : O) = ⟨c, e⟩ := FaithfulSMul.algebraMap_injective O Q2 h
  exact congrArg QuadraticAlgebra.re h1

/-- `D = (−12 − 8√2, −32 − 24√2)` has order exactly `10`; with `card_torsion_E1K`, the torsion subgroup is
cyclic of order `10`, generated by `D`. -/
theorem addOrderOf_pD : addOrderOf pD = 10 := by
  have hdvd : addOrderOf pD ∣ 10 := addOrderOf_dvd_of_nsmul_eq_zero ten_D
  have h2 : (2 : ℕ) • pD ≠ 0 := by rw [two_nsmul, dblD]; exact Point.some_ne_zero _
  have h5 : (5 : ℕ) • pD ≠ 0 := by
    intro h0
    have e5 : (5 : ℕ) • pD = pD + pA := by
      calc (5 : ℕ) • pD = pD + ((pD + pD) + (pD + pD)) := by abel
        _ = pD + pA := by rw [dblD, dblC]
    rw [e5] at h0
    have h' : pDm = pA := by rw [← negD]; exact neg_eq_of_add_eq_zero_right h0
    have hx := ((Point.some.injEq _ _ _ _ _ _).mp h').1
    exact absurd (q_inj_re hx) (by norm_num)
  have h1 : (1 : ℕ) • pD ≠ 0 := by rw [one_nsmul]; exact Point.some_ne_zero _
  have hmem : addOrderOf pD ∈ Nat.divisors 10 := Nat.mem_divisors.mpr ⟨hdvd, by norm_num⟩
  have hdiv : Nat.divisors 10 = {1, 2, 5, 10} := by decide
  rw [hdiv] at hmem
  simp only [Finset.mem_insert, Finset.mem_singleton] at hmem
  rcases hmem with h | h | h | h
  · exact absurd (h ▸ addOrderOf_nsmul_eq_zero pD) h1
  · exact absurd (h ▸ addOrderOf_nsmul_eq_zero pD) h2
  · exact absurd (h ▸ addOrderOf_nsmul_eq_zero pD) h5
  · exact h

/-! ### Interface with rank 0 in the form `finrank ℤ E1(ℚ(√2)) = 0` (the notion of `Rank.lean`) -/

/-- If `finrank ℤ E1(ℚ(√2)) = 0`, every point has finite order (`E1K_fg` and
`Module.finrank_eq_zero_iff_isTorsion`). -/
theorem torsion_of_finrank_eq_zero (h : Module.finrank ℤ E1K.Point = 0) (P : E1K.Point) :
    IsOfFinAddOrder P := by
  have : IsAddFG E1K.Point := E1K_fg
  have : Module.Finite ℤ E1K.Point := inferInstance
  have ht : Module.IsTorsion ℤ E1K.Point := Module.finrank_eq_zero_iff_isTorsion.mp h
  obtain ⟨⟨a, ha⟩, hP⟩ := @ht P
  exact isOfFinAddOrder_iff_zsmul_eq_zero.mpr ⟨a, nonZeroDivisors.ne_zero ha, hP⟩

/-- **Lemma D from `finrank ℤ E1(ℚ(√2)) = 0`.** -/
theorem lemmaD_of_finrank_eq_zero (h : Module.finrank ℤ E1K.Point = 0) : LemmaD :=
  lemmaD_of_torsion (torsion_of_finrank_eq_zero h)

/-- If `finrank ℤ E1(ℚ(√2)) = 0`, then `E1(ℚ(√2))` has exactly `10` points. -/
theorem natCard_E1K_of_finrank_eq_zero (h : Module.finrank ℤ E1K.Point = 0) :
    Nat.card E1K.Point = 10 := by
  rw [← card_torsion_E1K]
  exact Nat.card_congr (Equiv.subtypeUnivEquiv (torsion_of_finrank_eq_zero h)).symm

/-- **The torsion subgroup of `E1(ℚ(√2))` is the cyclic group generated by `D`**:
a point has finite order iff it is an integer multiple of `D = (−12 − 8√2, −32 − 24√2)`. -/
theorem torsion_iff_mem_zmultiples (P : E1K.Point) :
    IsOfFinAddOrder P ↔ P ∈ AddSubgroup.zmultiples pD := by
  constructor
  · intro hP
    let f : AddSubgroup.zmultiples pD → {Q : E1K.Point // IsOfFinAddOrder Q} := fun s =>
      ⟨s.1, by
        obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp s.2
        rw [← hk]; exact tors_D.zsmul⟩
    have hf : Function.Injective f := fun s t h => Subtype.ext (by
      have h' := congrArg Subtype.val h
      exact h')
    have hcard : Nat.card {Q : E1K.Point // IsOfFinAddOrder Q} ≤
        Nat.card (AddSubgroup.zmultiples pD) := by
      rw [card_torsion_E1K, Nat.card_zmultiples, addOrderOf_pD]
    have hfin : Finite {Q : E1K.Point // IsOfFinAddOrder Q} :=
      Nat.finite_of_card_ne_zero (by rw [card_torsion_E1K]; norm_num)
    obtain ⟨s, hs⟩ := (hf.bijective_of_nat_card_le hcard).2 ⟨P, hP⟩
    have hsP : s.1 = P := congrArg Subtype.val hs
    rw [← hsP]; exact s.2
  · intro h
    obtain ⟨k, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp h
    exact tors_D.zsmul

end MagicSquareOfSquares.Family.TorsionE1

