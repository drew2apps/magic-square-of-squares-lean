import LeanRank.CensusClosure

/-!
# Axiom audit of `LeanRank.CensusClosure`, generated from the environment

Written by an AI model; not read by a person.  Not part of the library.  Run with
`lake env lean scripts/CensusClosureAxioms.lean` from `lean_rank/`.  Expected: no error, and one
info line with the number of declarations.

Every constant whose name starts with `LeanRank.CensusClosure` (including auxiliary lemmas and
instances generated by Lean) is passed to `Lean.collectAxioms`; the command fails if any axiom
other than `propext`, `Classical.choice`, `Quot.sound` occurs (for example `sorryAx`).  This does
not depend on the hand-written `#print axioms` lines of the library file.  Negative test:
`scripts/CensusClosureAxiomsForge.lean` (the same command after one `sorry` in the namespace) must fail.
-/

open Lean Elab Command

run_cmd do
  let env ← getEnv
  let decls := env.constants.fold (init := (#[] : Array Name)) fun acc c _ =>
    if (`LeanRank.CensusClosure).isPrefixOf c then acc.push c else acc
  let std : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  let mut bad : Array (Name × Name) := #[]
  let mut used : Array Name := #[]
  for c in decls do
    let axs ← Lean.collectAxioms c
    for a in axs do
      unless used.contains a do used := used.push a
      unless std.contains a do bad := bad.push (c, a)
  if decls.size < 100 then throwError m!"only {decls.size} declarations found"
  unless bad.isEmpty do throwError m!"non-standard axioms: {bad}"
  logInfo m!"{decls.size} declarations in LeanRank.CensusClosure; axioms used: {used}"
