import LeanRank.RankZeroCensus
import LeanRank.RankZeroPoints

/-!
# All rational points of the census curves `w·f0·f8`, and the ratios they close (generated)

Written by an AI model; not read by a person.  Generated by `scripts/gen_census_closure.py`
(untrusted, pure Python: the points by halving, the prime by counting points modulo `p`) from the
template `scripts/census_closure_head.lean.in`; Lean re-checks everything.

For a census pair `(m, n)` of `G1_FULL_SYSTEM.md`, Result 3, closed by the curve `w·f0·f8`, let
`E : Y² = X(X + m⁴)(X + n⁴)` (`curve (−m⁴) (−n⁴)`).  For each pair below:

* `card_le_m_n`: `#E(ℚ) ≤ N`.  `rank E(ℚ) = 0` (`LeanRank.RankZeroCensus.finrank_m_n`, run 3)
  makes every point torsion; M. Stoll's reduction map at an odd prime `p` of good reduction
  (`EllipticCurves.ReductionAtPrime`) is injective on torsion, and `#Ẽ(𝔽_p) = N`
  (`decide +kernel` over `ZMod p`).
* `points_m_n`, `card_m_n`, `affine_m_n`: **`E(ℚ)` is exactly the `N` listed points.**
* `tau_m_n`: if `m² + n²τ²` and `n² + m²τ²` are both squares of rationals, then `τ ∈ {0, 1, −1}`.
  (`(m²n²τ², m²n²·τ·r0·r8)` is a point of `E`; its abscissa is one of the listed ones, and each
  listed abscissa other than `0` and `m²n²` is negative or `m²n²` times a non-square.)
* `ratio_ne_m_n`: **in a 3×3 magic square of the squares of nine integers
  `a b c / d e f / g h i` (any signs) with `b² ≠ d²` and `b² ≠ f²`, the edge roots do not satisfy
  `(b + d) : (h + f) = m : n`.**  Through `ratio_ne_of_tau`: `τ = 0` forces `b = −d`, and
  `τ = ±1` forces `b = ±f`.
* `mss_forms`, `mss_point` (any `m`, `n`): a magic square of squares with
  `(b + d)·n = (h + f)·m`, `h + f ≠ 0`, `b ≠ d` gives, at `τ = (h + f)/(b − d)`, rationals `r0`,
  `r8` with `r0² = m² + n²τ²`, `r8² = n² + m²τ²`, and the point `(m²n²τ², m²n²·τ·r0·r8)` of `E`.
  The parametrisation is that of `MagicSquareOfSquares.IsMSS.fullSquares` (`G1Bridge.lean`, main
  library), redone here from the eight line equations for the two corners `a`, `i` only.
* `ratio_ne_partner`, and `ratio_ne_M_N` for each partner `M : N = (m + n) : (m − n)` (in lowest
  terms) of a pair above that is not itself above: the reflected square `c b a / f e d / i (−h) g`
  has the partner ratio, so the partner ratio is excluded too, under the same two hypotheses.

The hypotheses `b² ≠ d²`, `b² ≠ f²` hold when the nine entries are distinct.  The eight
hypotheses `r₁ … ad` are the fields of `MagicSquareOfSquares.IsMagic (a²) … (i²) T`, that is
`MagicSquareOfSquares.IsMSS a b c d e f g h i T` of the main library (not imported: lean_rank
compiles only four main-library modules).
-/

open WeierstrassCurve WeierstrassCurve.Affine IsDedekindDomain IsDedekindDomain.HeightOneSpectrum
open LeanRank.RankZeroGen

namespace LeanRank.CensusClosure

open LeanRank.RankZero (intPrime intPrime_asIdeal residueZModAlgEquiv int_sq_of_rat_sq)

/-! ### Reduction at an odd prime: `#E(ℚ) ≤ #Ẽ(𝔽_p)` when the rank is `0` -/

/-- The integral model `y² = x³ + (a + b)x² + abx` of `curve (−a) (−b)`. -/
def W₀ (a b : ℤ) : WeierstrassCurve ℤ := ⟨0, a + b, 0, a * b, 0⟩

theorem map_W₀ (a b : ℤ) : (W₀ a b).map (algebraMap ℤ ℚ) = curve (-a) (-b) := by
  ext <;> simp [W₀, curve] <;> ring

theorem Δ_W₀ (a b : ℤ) : (W₀ a b).Δ = 16 * (a * b * (a - b)) ^ 2 := by
  simp only [W₀, WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
    WeierstrassCurve.b₆, WeierstrassCurve.b₈]
  ring

theorem redCurve_isElliptic (p : ℕ) [Fact p.Prime] (a b : ℤ)
    (h : ¬ (p : ℤ) ∣ 16 * (a * b * (a - b)) ^ 2) :
    (redCurve (intPrime p) (W₀ a b)).IsElliptic := by
  rw [isElliptic_iff, isUnit_iff_ne_zero]
  change ((W₀ a b).map (algebraMap ℤ (ℤ ⧸ (intPrime p).asIdeal))).Δ ≠ 0
  rw [Ne, map_Δ, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem,
    intPrime_asIdeal, Ideal.mem_span_singleton, Δ_W₀]
  exact h

/-- Rank `0` (Mordell–Weil, Stoll's `fg_point_of_numberField`): every point has finite order. -/
theorem isOfFinAddOrder_of_finrank {E : Affine ℚ} [E.IsElliptic]
    (h : Module.finrank ℤ E.Point = 0) (P : E.Point) : IsOfFinAddOrder P := by
  have : IsAddFG E.Point := fg_point_of_numberField
  have hfin : Module.Finite ℤ E.Point := by exact inferInstance
  have ht : Module.IsTorsion ℤ E.Point := Module.finrank_eq_zero_iff_isTorsion.mp h
  exact (isAddTorsion_iff_isTorsion_int.mpr ht) P

/-- Reduction at `p` is injective on `E(ℚ)` when every point is torsion.  `hram` is the condition
`p ∉ (p)^{p−1}` of Stoll's lemma, i.e. `p^{p−1} ∤ p`; it holds for every odd prime. -/
theorem red_injective (p : ℕ) [Fact p.Prime] (a b : ℤ) [(curve (-a) (-b)).IsElliptic]
    [(redCurve (intPrime p) (W₀ a b)).IsElliptic]
    (hram : ¬ ((p : ℤ) ^ (p - 1) ∣ (p : ℤ)))
    (htors : ∀ P : (curve (-a) (-b)).Point, IsOfFinAddOrder P) :
    Function.Injective (redHom (intPrime p) (map_W₀ a b)) := by
  intro P Q hPQ
  have h0 : red (intPrime p) (map_W₀ a b) (P - Q) = 0 := by
    rw [← coe_redHom, map_sub]
    exact sub_eq_zero.mpr hPQ
  exact sub_eq_zero.mp (eq_zero_of_isOfFinAddOrder_of_red_eq_zero (intPrime p) (map_W₀ a b)
    (p := p) Fact.out (Ideal.mem_span_singleton_self _)
    (by rw [intPrime_asIdeal, Ideal.span_singleton_pow, Ideal.mem_span_singleton]; exact hram)
    (htors _) h0)

theorem natCard_red (p : ℕ) [Fact p.Prime] [NeZero p] (a b : ℤ)
    [(redCurve (intPrime p) (W₀ a b)).IsElliptic] (Ep : WeierstrassCurve (ZMod p))
    (hE : (((W₀ a b).toAffine ⁄ (ZMod p)) : WeierstrassCurve _).toAffine = Ep.toAffine) {N : ℕ}
    (hN : Fintype.card Ep.toAffine.Point = N) :
    Nat.card (redCurve (intPrime p) (W₀ a b)).Point = N := by
  have e : (redCurve (intPrime p) (W₀ a b)).Point ≃+ Ep.toAffine.Point :=
    (Point.mapEquiv (W' := (W₀ a b).toAffine) (residueZModAlgEquiv p)).trans (Point.congr hE)
  rw [Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card, hN]

/-- **`E(ℚ)` is finite and `#E(ℚ) ≤ #Ẽ(𝔽_p)`** for `E = curve (−a) (−b)` of rank `0` and an odd
prime `p` of good reduction of `W₀ a b`. -/
theorem card_le (p : ℕ) [Fact p.Prime] [NeZero p] (a b : ℤ) [(curve (-a) (-b)).IsElliptic]
    [(redCurve (intPrime p) (W₀ a b)).IsElliptic]
    (hram : ¬ ((p : ℤ) ^ (p - 1) ∣ (p : ℤ)))
    (h0 : Module.finrank ℤ (curve (-a) (-b)).Point = 0) (Ep : WeierstrassCurve (ZMod p))
    (hE : (((W₀ a b).toAffine ⁄ (ZMod p)) : WeierstrassCurve _).toAffine = Ep.toAffine) {N : ℕ}
    (hN : Fintype.card Ep.toAffine.Point = N) :
    Finite (curve (-a) (-b)).Point ∧ Nat.card (curve (-a) (-b)).Point ≤ N := by
  have hc := natCard_red p a b Ep hE hN
  have : Finite (redCurve (intPrime p) (W₀ a b)).Point :=
    Finite.of_equiv _ ((Point.mapEquiv (W' := (W₀ a b).toAffine)
      (residueZModAlgEquiv p)).trans (Point.congr hE)).toEquiv.symm
  have hinj := red_injective p a b hram (isOfFinAddOrder_of_finrank h0)
  refine ⟨Finite.of_injective _ hinj, ?_⟩
  calc Nat.card (curve (-a) (-b)).Point ≤ Nat.card (redCurve (intPrime p) (W₀ a b)).Point :=
        Nat.card_le_card_of_injective _ hinj
    _ = N := hc

/-- Coordinates of a point (`none` for `O`). -/
def key {E : Affine ℚ} : E.Point → Option (ℚ × ℚ)
  | .zero => none
  | .some x y _ => some (x, y)

theorem ns {e₂ e₃ : ℤ} [(curve e₂ e₃).IsElliptic] {x y : ℚ}
    (h : y ^ 2 = x * (x - e₂) * (x - e₃)) : (curve e₂ e₃).Nonsingular x y :=
  (curve e₂ e₃).equation_iff_nonsingular.mp ((LeanRank.RankZeroGen.equation_iff' x y).mpr h)

/-! ### From an abscissa `c·τ²` to `τ` -/

/-- `N` strictly between two consecutive squares is not the square of a rational. -/
theorem not_sq_between {N k : ℕ} (h1 : k * k < N) (h2 : N < (k + 1) * (k + 1)) {r : ℚ}
    (h : r ^ 2 = N) : False := by
  obtain ⟨z, hz⟩ := int_sq_of_rat_sq (N := (N : ℤ)) (by exact_mod_cast h)
  have hk : z.natAbs * z.natAbs = N := by
    have : ((z.natAbs * z.natAbs : ℕ) : ℤ) = (N : ℤ) := by
      rw [Int.natAbs_mul_self, ← sq, hz]
    exact_mod_cast this
  rcases lt_or_ge k z.natAbs with h3 | h3
  · have h4 := Nat.mul_le_mul (Nat.succ_le_of_lt h3) (Nat.succ_le_of_lt h3)
    rw [hk] at h4
    exact absurd h2 (not_lt.mpr h4)
  · have h4 := Nat.mul_le_mul h3 h3
    rw [hk] at h4
    exact absurd h1 (not_lt.mpr h4)

theorem tau_nonsq {c x τ : ℚ} (hc : c ≠ 0) (h : c * τ ^ 2 = x) {N k Q : ℕ}
    (hN : x * (Q : ℚ) ^ 2 = c * N) (h1 : k * k < N) (h2 : N < (k + 1) * (k + 1)) : False := by
  refine not_sq_between h1 h2 (r := Q * τ) ?_
  have e : c * ((Q * τ) ^ 2 - N) = 0 := by linear_combination (Q : ℚ) ^ 2 * h + hN
  linear_combination (mul_eq_zero.mp e).resolve_left hc

theorem tau_neg {c x τ : ℚ} (hc : 0 < c) (h : c * τ ^ 2 = x) (hx : x < 0) : False := by
  nlinarith [sq_nonneg τ]

theorem tau_zero {c τ : ℚ} (hc : c ≠ 0) (h : c * τ ^ 2 = 0) : τ = 0 :=
  pow_eq_zero_iff two_ne_zero |>.mp ((mul_eq_zero.mp h).resolve_left hc)

theorem tau_one {c τ : ℚ} (hc : c ≠ 0) (h : c * τ ^ 2 = c) : τ = 1 ∨ τ = -1 := by
  have h' : c * ((τ - 1) * (τ + 1)) = 0 := by linear_combination h
  rcases mul_eq_zero.mp ((mul_eq_zero.mp h').resolve_left hc) with h1 | h1
  · left; linarith
  · right; linarith

/-! ### From a magic square of squares at the ratio `m : n` to a point of `w·f0·f8` -/

/-- **The parametrisation of a magic square of squares at the ratio `m : n`** (that of
`MagicSquareOfSquares.IsMSS.fullSquares`, `G1Bridge.lean`, redone here for the corners `a`, `i`):
`b = mA + nB`, `f = nA + mB`, `a² = n²A² + m²B²`, `i² = m²A² + n²B²`, with `2nA = h + f`,
`2nB = b − d`. -/
theorem mss_forms {m n : ℕ} (hn : 0 < n) {a b c d e f g h i T : ℤ}
    (r₁ : a ^ 2 + b ^ 2 + c ^ 2 = T) (r₂ : d ^ 2 + e ^ 2 + f ^ 2 = T)
    (r₃ : g ^ 2 + h ^ 2 + i ^ 2 = T) (c₁ : a ^ 2 + d ^ 2 + g ^ 2 = T)
    (c₂ : b ^ 2 + e ^ 2 + h ^ 2 = T) (c₃ : c ^ 2 + f ^ 2 + i ^ 2 = T)
    (dg : a ^ 2 + e ^ 2 + i ^ 2 = T) (ad : c ^ 2 + e ^ 2 + g ^ 2 = T)
    (hmn : (b + d) * n = (h + f) * m) (hne : h + f ≠ 0) (hbd : b ≠ d) :
    ∃ A B : ℚ, B ≠ 0 ∧ 2 * n * A = (h : ℚ) + f ∧ 2 * n * B = (b : ℚ) - d ∧
      (b : ℚ) = m * A + n * B ∧ (f : ℚ) = n * A + m * B ∧
      (a : ℚ) ^ 2 = (n : ℚ) ^ 2 * A ^ 2 + (m : ℚ) ^ 2 * B ^ 2 ∧
      (i : ℚ) ^ 2 = (m : ℚ) ^ 2 * A ^ 2 + (n : ℚ) ^ 2 * B ^ 2 := by
  have e1 : b ^ 2 + h ^ 2 = d ^ 2 + f ^ 2 := by linarith
  have ea : 2 * a ^ 2 = f ^ 2 + h ^ 2 := by linarith
  have ei : 2 * i ^ 2 = b ^ 2 + d ^ 2 := by linarith
  have e1q : (b : ℚ) ^ 2 + (h : ℚ) ^ 2 = (d : ℚ) ^ 2 + (f : ℚ) ^ 2 := by exact_mod_cast e1
  have eaq : 2 * (a : ℚ) ^ 2 = (f : ℚ) ^ 2 + (h : ℚ) ^ 2 := by exact_mod_cast ea
  have eiq : 2 * (i : ℚ) ^ 2 = (b : ℚ) ^ 2 + (d : ℚ) ^ 2 := by exact_mod_cast ei
  have hmnq : ((b : ℚ) + d) * n = ((h : ℚ) + f) * m := by exact_mod_cast hmn
  have hneq : (h : ℚ) + f ≠ 0 := by exact_mod_cast hne
  have hbdq : (b : ℚ) - d ≠ 0 := sub_ne_zero.mpr (by exact_mod_cast hbd)
  have hnq : (n : ℚ) ≠ 0 := by exact_mod_cast hn.ne'
  have h2n : (2 : ℚ) * n ≠ 0 := mul_ne_zero two_ne_zero hnq
  have key : (m : ℚ) * ((b : ℚ) - d) = n * ((f : ℚ) - h) := by
    apply mul_left_cancel₀ hneq
    linear_combination (-((b : ℚ) - d)) * hmnq + (n : ℚ) * e1q
  obtain ⟨A, hA⟩ : ∃ A : ℚ, 2 * n * A = (h : ℚ) + f := ⟨((h : ℚ) + f) / (2 * n), by field_simp⟩
  obtain ⟨B, hB⟩ : ∃ B : ℚ, 2 * n * B = (b : ℚ) - d := ⟨((b : ℚ) - d) / (2 * n), by field_simp⟩
  have hB0 : B ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at hB
    exact hbdq hB.symm
  have hb : (b : ℚ) = m * A + n * B := by
    apply mul_left_cancel₀ h2n
    linear_combination hmnq - (m : ℚ) * hA - (n : ℚ) * hB
  have hd : (d : ℚ) = m * A - n * B := by
    apply mul_left_cancel₀ h2n
    linear_combination hmnq - (m : ℚ) * hA + (n : ℚ) * hB
  have hh : (h : ℚ) = n * A - m * B := by
    apply mul_left_cancel₀ h2n
    linear_combination key - (n : ℚ) * hA + (m : ℚ) * hB
  have hf : (f : ℚ) = n * A + m * B := by
    apply mul_left_cancel₀ h2n
    linear_combination -key - (n : ℚ) * hA - (m : ℚ) * hB
  have ha2 : (a : ℚ) ^ 2 = (n : ℚ) ^ 2 * A ^ 2 + (m : ℚ) ^ 2 * B ^ 2 := by
    rw [hf, hh] at eaq
    linear_combination (1 / 2 : ℚ) * eaq
  have hi2 : (i : ℚ) ^ 2 = (m : ℚ) ^ 2 * A ^ 2 + (n : ℚ) ^ 2 * B ^ 2 := by
    rw [hb, hd] at eiq
    linear_combination (1 / 2 : ℚ) * eiq
  exact ⟨A, B, hB0, hA, hB, hb, hf, ha2, hi2⟩

/-- **A magic square of squares at the ratio `m : n` gives a rational point of the curve
`w·f0·f8`** (`G1_FULL_SYSTEM.md`, Result 3, with `w = τ²`): for `τ = (h + f)/(b − d)`, the values
`m² + n²τ²` and `n² + m²τ²` are the squares of `r0 = a/B`, `r8 = i/B`, and
`(m²n²τ², m²n²·τ·r0·r8)` lies on `Y² = X(X + m⁴)(X + n⁴)`. -/
theorem mss_point {m n : ℕ} (hn : 0 < n) {a b c d e f g h i T : ℤ}
    (r₁ : a ^ 2 + b ^ 2 + c ^ 2 = T) (r₂ : d ^ 2 + e ^ 2 + f ^ 2 = T)
    (r₃ : g ^ 2 + h ^ 2 + i ^ 2 = T) (c₁ : a ^ 2 + d ^ 2 + g ^ 2 = T)
    (c₂ : b ^ 2 + e ^ 2 + h ^ 2 = T) (c₃ : c ^ 2 + f ^ 2 + i ^ 2 = T)
    (dg : a ^ 2 + e ^ 2 + i ^ 2 = T) (ad : c ^ 2 + e ^ 2 + g ^ 2 = T)
    (hmn : (b + d) * n = (h + f) * m) (hne : h + f ≠ 0) (hbd : b ≠ d) :
    ∃ τ r0 r8 : ℚ, τ = ((h : ℚ) + f) / ((b : ℚ) - d) ∧
      r0 ^ 2 = (m : ℚ) ^ 2 + (n : ℚ) ^ 2 * τ ^ 2 ∧ r8 ^ 2 = (n : ℚ) ^ 2 + (m : ℚ) ^ 2 * τ ^ 2 ∧
      (curve (-(m : ℤ) ^ 4) (-(n : ℤ) ^ 4)).Equation ((m : ℚ) ^ 2 * (n : ℚ) ^ 2 * τ ^ 2)
        ((m : ℚ) ^ 2 * (n : ℚ) ^ 2 * τ * r0 * r8) := by
  obtain ⟨A, B, hB0, hA, hB, -, -, ha2, hi2⟩ := mss_forms hn r₁ r₂ r₃ c₁ c₂ c₃ dg ad hmn hne hbd
  have hnq : (n : ℚ) ≠ 0 := by exact_mod_cast hn.ne'
  have hτ : ((h : ℚ) + f) / ((b : ℚ) - d) = A / B := by
    rw [← hA, ← hB, mul_div_mul_left _ _ (mul_ne_zero two_ne_zero hnq)]
  set τ : ℚ := A / B with hτdef
  have hAτ : A = τ * B := (div_mul_cancel₀ A hB0).symm
  have hr0 : ((a : ℚ) / B) ^ 2 = (m : ℚ) ^ 2 + (n : ℚ) ^ 2 * τ ^ 2 := by
    rw [div_pow, div_eq_iff (pow_ne_zero 2 hB0), ha2, hAτ]
    ring
  have hr8 : ((i : ℚ) / B) ^ 2 = (n : ℚ) ^ 2 + (m : ℚ) ^ 2 * τ ^ 2 := by
    rw [div_pow, div_eq_iff (pow_ne_zero 2 hB0), hi2, hAτ]
    ring
  refine ⟨τ, (a : ℚ) / B, (i : ℚ) / B, hτ.symm, hr0, hr8, ?_⟩
  rw [LeanRank.RankZeroGen.equation_iff']
  have e : ((m : ℚ) ^ 2 * (n : ℚ) ^ 2 * τ * ((a : ℚ) / B) * ((i : ℚ) / B)) ^ 2 =
      (m : ℚ) ^ 4 * (n : ℚ) ^ 4 * τ ^ 2 * ((a : ℚ) / B) ^ 2 * ((i : ℚ) / B) ^ 2 := by ring
  rw [e, hr0, hr8]
  push_cast
  ring

/-- If, for the ratio `m : n`, the only rational `τ` with `m² + n²τ²` and `n² + m²τ²` both squares
are `0, ±1`, then no magic square of squares with `b² ≠ d²`, `b² ≠ f²` has
`(b + d) : (h + f) = m : n`. -/
theorem ratio_ne_of_tau {m n : ℕ} (hm : 0 < m) (hn : 0 < n)
    (hτ : ∀ τ r0 r8 : ℚ, r0 ^ 2 = (m : ℚ) ^ 2 + (n : ℚ) ^ 2 * τ ^ 2 →
      r8 ^ 2 = (n : ℚ) ^ 2 + (m : ℚ) ^ 2 * τ ^ 2 → τ = 0 ∨ τ = 1 ∨ τ = -1)
    {a b c d e f g h i T : ℤ}
    (r₁ : a ^ 2 + b ^ 2 + c ^ 2 = T) (r₂ : d ^ 2 + e ^ 2 + f ^ 2 = T)
    (r₃ : g ^ 2 + h ^ 2 + i ^ 2 = T) (c₁ : a ^ 2 + d ^ 2 + g ^ 2 = T)
    (c₂ : b ^ 2 + e ^ 2 + h ^ 2 = T) (c₃ : c ^ 2 + f ^ 2 + i ^ 2 = T)
    (dg : a ^ 2 + e ^ 2 + i ^ 2 = T) (ad : c ^ 2 + e ^ 2 + g ^ 2 = T)
    (hbd : b ^ 2 ≠ d ^ 2) (hbf : b ^ 2 ≠ f ^ 2) :
    (b + d) * n ≠ (h + f) * m := by
  intro hmn
  have hn' : (n : ℤ) ≠ 0 := by exact_mod_cast hn.ne'
  have hne : h + f ≠ 0 := by
    intro h0
    rw [h0, zero_mul] at hmn
    have hbd0 : b + d = 0 := (mul_eq_zero.mp hmn).resolve_right hn'
    apply hbd
    rw [show b = -d by linarith]
    ring
  have hbd' : b ≠ d := fun h1 => hbd (by rw [h1])
  obtain ⟨A, B, hB0, hA, -, hb, hf, ha2, hi2⟩ :=
    mss_forms hn r₁ r₂ r₃ c₁ c₂ c₃ dg ad hmn hne hbd'
  have hneq : (h : ℚ) + f ≠ 0 := by exact_mod_cast hne
  set τ : ℚ := A / B with hτdef
  have hAτ : A = τ * B := (div_mul_cancel₀ A hB0).symm
  have hr0 : ((a : ℚ) / B) ^ 2 = (m : ℚ) ^ 2 + (n : ℚ) ^ 2 * τ ^ 2 := by
    rw [div_pow, div_eq_iff (pow_ne_zero 2 hB0), ha2, hAτ]
    ring
  have hr8 : ((i : ℚ) / B) ^ 2 = (n : ℚ) ^ 2 + (m : ℚ) ^ 2 * τ ^ 2 := by
    rw [div_pow, div_eq_iff (pow_ne_zero 2 hB0), hi2, hAτ]
    ring
  rcases hτ τ _ _ hr0 hr8 with h0 | h1 | h1
  · -- `τ = 0`: `h + f = 0`
    apply hneq
    rw [← hA, hAτ, h0]
    ring
  · -- `τ = 1`: `b = f`
    apply hbf
    have hbfq : (b : ℚ) = f := by rw [hb, hf, hAτ, h1]; ring
    have : b = f := by exact_mod_cast hbfq
    rw [this]
  · -- `τ = −1`: `b = −f`
    apply hbf
    have hbfq : (b : ℚ) = -f := by rw [hb, hf, hAτ, h1]; ring
    have : b = -f := by exact_mod_cast hbfq
    rw [this]
    ring

/-! ### The partner ratio -/

/-- **The partner ratio** (`G1_FULL_SYSTEM.md`, "The system": `(m, n, t)` and
`(m + n, m − n, (t + 1)/(t − 1))` give the same square): reflecting a magic square of squares in
its middle column and changing the sign of `h` gives the square `c b a / f e d / i (−h) g`, whose
edge ratio is `(b + f) : (d − h) = (m + n) : (m − n)` when that of the original is `m : n`.  So a
ratio is excluded as soon as its partner `M : N` (with `(m + n)·N = (m − n)·M`) is.  The two
hypotheses `b² ≠ d²`, `b² ≠ f²` are exchanged by the reflection. -/
theorem ratio_ne_partner {m n M N : ℕ} (hn : 0 < n)
    (hMN : ((m : ℤ) + n) * N = ((m : ℤ) - n) * M)
    (hpart : ∀ a b c d e f g h i T : ℤ,
      a ^ 2 + b ^ 2 + c ^ 2 = T → d ^ 2 + e ^ 2 + f ^ 2 = T → g ^ 2 + h ^ 2 + i ^ 2 = T →
      a ^ 2 + d ^ 2 + g ^ 2 = T → b ^ 2 + e ^ 2 + h ^ 2 = T → c ^ 2 + f ^ 2 + i ^ 2 = T →
      a ^ 2 + e ^ 2 + i ^ 2 = T → c ^ 2 + e ^ 2 + g ^ 2 = T →
      b ^ 2 ≠ d ^ 2 → b ^ 2 ≠ f ^ 2 → (b + d) * N ≠ (h + f) * M)
    {a b c d e f g h i T : ℤ}
    (r₁ : a ^ 2 + b ^ 2 + c ^ 2 = T) (r₂ : d ^ 2 + e ^ 2 + f ^ 2 = T)
    (r₃ : g ^ 2 + h ^ 2 + i ^ 2 = T) (c₁ : a ^ 2 + d ^ 2 + g ^ 2 = T)
    (c₂ : b ^ 2 + e ^ 2 + h ^ 2 = T) (c₃ : c ^ 2 + f ^ 2 + i ^ 2 = T)
    (dg : a ^ 2 + e ^ 2 + i ^ 2 = T) (ad : c ^ 2 + e ^ 2 + g ^ 2 = T)
    (hbd : b ^ 2 ≠ d ^ 2) (hbf : b ^ 2 ≠ f ^ 2) :
    (b + d) * n ≠ (h + f) * m := by
  intro hmn
  have hn' : (n : ℤ) ≠ 0 := by exact_mod_cast hn.ne'
  have hne : h + f ≠ 0 := by
    intro h0
    rw [h0, zero_mul] at hmn
    have hbd0 : b + d = 0 := (mul_eq_zero.mp hmn).resolve_right hn'
    apply hbd
    rw [show b = -d by linarith]
    ring
  have hbd' : b ≠ d := fun h1 => hbd (by rw [h1])
  obtain ⟨A, B, -, hA, hB, hb, hf, -, -⟩ := mss_forms hn r₁ r₂ r₃ c₁ c₂ c₃ dg ad hmn hne hbd'
  have hd : (d : ℚ) = m * A - n * B := by linear_combination hb + hB
  have hh : (h : ℚ) = n * A - m * B := by linear_combination -hA - hf
  have hMNq : ((m : ℚ) + n) * N = ((m : ℚ) - n) * M := by exact_mod_cast hMN
  have hq : ((b : ℚ) + f) * N = (-(h : ℚ) + d) * M := by
    rw [hb, hf, hh, hd]
    linear_combination (A + B) * hMNq
  have hz : (b + f) * (N : ℤ) = (-h + d) * (M : ℤ) := by exact_mod_cast hq
  exact hpart c b a f e d i (-h) g T (by linarith) (by linarith) (by rw [neg_sq]; linarith)
    (by linarith) (by rw [neg_sq]; linarith) (by linarith) (by linarith) (by linarith) hbf hbd hz

