import MagicSquareOfSquares.G1Bridge

/-!
# The G1 family with all nine cells: census for `m ≤ 1000`

Generated by `scripts/g1_full/gen_census1000.py`. Do not edit by hand.

Of the @NPAIRS@ coprime pairs `1 ≤ n < m ≤ 1000`, @NCLOSED@ are closed here by a congruence at
one prime. The other @NEXC@ are listed in `exceptions1000`; @TRIV@ of them have `m² + n²` or
`(m² + n²)/2` a square. The census is evaluated by the Lean kernel in blocks.

* `no_solution_le_1000`: for coprime `1 ≤ n < m ≤ 1000` outside `exceptions1000`, no rational
  `t` makes the five cells squares.
* `IsMSS.ratio_ne_of_le_1000`: the same statement for the edge roots of a magic square of
  squares.
-/

namespace MagicSquareOfSquares.G1

/-- `(p, S, R)`: a prime, the mask of squares modulo `p`, and the mask of obstructed ratios. -/
def maskTable : List (ℕ × ℕ × ℕ) := [
@ROWS@]

/-- One entry: the mask of squares is right and the check succeeds for every ratio in `R`. -/
def maskOk (e : ℕ × ℕ × ℕ) : Bool :=
  decide (e.2.1 = sqMask e.1) &&
    (List.range e.1).all fun r => !e.2.2.testBit r || obstructsFull r 1 e.1 e.1 e.2.1

theorem maskTable_valid : maskTable.all maskOk = true := by decide +kernel

theorem maskTable_primes : maskTable.map Prod.fst = primeList := by decide +kernel

/-- A candidate for `m / n` modulo the prime `p`. It is checked, not trusted. -/
def ratioOf (m n p : ℕ) : ℕ := m * n ^ (p - 2) % p

/-- `certifiedMask m n`: some table entry applies to `(m, n)`. -/
def certifiedMask (m n : ℕ) : Bool :=
  maskTable.any fun e =>
    decide (n % e.1 ≠ 0) && e.2.2.testBit (ratioOf m n e.1) &&
      decide (m % e.1 = ratioOf m n e.1 * n % e.1)

theorem no_solution_of_certifiedMask {m n : ℕ} (h : certifiedMask m n = true) (t : ℚ) :
    ¬FullSquares m n t := by
  unfold certifiedMask at h
  obtain ⟨⟨p, S, R⟩, he, h2⟩ := List.any_eq_true.mp h
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h2
  obtain ⟨⟨hn, hbit⟩, hmr⟩ := h2
  have hv := List.all_eq_true.mp maskTable_valid _ he
  simp only [maskOk, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at hv
  obtain ⟨hS, hall⟩ := hv
  have hp : p.Prime := prime_of_mem_primeList (by
    rw [← maskTable_primes]
    exact List.mem_map_of_mem (f := Prod.fst) he)
  have hr := hall (ratioOf m n p) (List.mem_range.mpr (Nat.mod_lt _ hp.pos))
  rw [hbit] at hr
  exact no_solution_of_ratio hp hS (by simpa using hr) hmr hn t

/-- Primes `5 mod 8` used for the pairs that the table does not cover. -/
def fivePrimes1000 : List ℕ := @FIVE@

theorem fivePrimes1000_spec {p : ℕ} (h : p ∈ fivePrimes1000) : p.Prime ∧ p % 8 = 5 := by
  simp only [fivePrimes1000, List.mem_cons, List.mem_nil_iff, or_false] at h
  rcases h with @FIVEALTS@ <;> constructor <;> norm_num

/-- One of these primes divides `m² + n²` exactly once and does not divide `n`. -/
def fiveCert1000 (m n : ℕ) : Bool :=
  fivePrimes1000.any fun p =>
    decide ((m * m + n * n) % p = 0 ∧ (m * m + n * n) % (p * p) ≠ 0 ∧ n % p ≠ 0)

/-- `closed1000 m n`: one of the proved obstructions applies. -/
def closed1000 (m n : ℕ) : Bool :=
  certifiedMask m n || cond8 m n || cond32 m n || fiveCert1000 m n

theorem no_solution_of_closed1000 {m n : ℕ} (h : closed1000 m n = true) (t : ℚ) :
    ¬FullSquares m n t := by
  unfold closed1000 at h
  simp only [Bool.or_eq_true] at h
  rcases h with ((h | h) | h) | h
  · exact no_solution_of_certifiedMask h t
  · exact fun hf => no_point_of_two_mod_four
      (by simpa only [cond8, decide_eq_true_eq] using h) t hf.1
  · exact fun hf => no_point_of_odd
      (by simpa only [cond32, decide_eq_true_eq] using h) t hf.1
  · unfold fiveCert1000 at h
    obtain ⟨p, hp, h3⟩ := List.any_eq_true.mp h
    simp only [decide_eq_true_eq] at h3
    obtain ⟨d1, d2, d3⟩ := h3
    exact fun hf => no_point_of_exactly_divides (fivePrimes1000_spec hp).1
      (fivePrimes1000_spec hp).2 (Nat.dvd_of_mod_eq_zero d1)
      (fun hd => d2 (Nat.mod_eq_zero_of_dvd hd)) (fun hd => d3 (Nat.mod_eq_zero_of_dvd hd)) t hf.1

/-- The coprime pairs with `m ≤ 1000` that are not closed by the obstructions above. -/
def exceptions1000 : List (ℕ × ℕ) := @EXC@

theorem exceptions1000_length : exceptions1000.length = @NEXC@ := by decide +kernel

/-- The condition checked for each pair. -/
def pairOk (m n : ℕ) : Bool :=
  !(Nat.gcd m n == 1 && decide (0 < n)) || closed1000 m n || decide ((m, n) ∈ exceptions1000)

/-- All pairs `(m, n)` with `lo ≤ m < lo + len` and `n < m` pass. -/
def blockOk (lo len : ℕ) : Bool :=
  (List.range len).all fun i => (List.range (lo + i)).all fun n => pairOk (lo + i) n

theorem pairOk_of_block {lo len m n : ℕ} (h : blockOk lo len = true) (h1 : lo ≤ m)
    (h2 : m < lo + len) (hn : n < m) : pairOk m n = true := by
  unfold blockOk at h
  have h3 : ((List.range (lo + (m - lo))).all fun n => pairOk (lo + (m - lo)) n) = true :=
    List.all_eq_true.mp h (m - lo) (List.mem_range.mpr (by omega))
  have e : lo + (m - lo) = m := by omega
  rw [e] at h3
  exact List.all_eq_true.mp h3 n (List.mem_range.mpr hn)

@BLOCKS@

theorem pairOk_le_1000 {m n : ℕ} (hn : n < m) (hm : m ≤ 1000) : pairOk m n = true := by
  rcases (by omega : @DISJ@) with @RCASES@
@CASES@

/-- **For coprime `1 ≤ n < m ≤ 1000` outside `exceptions1000`, no rational `t` makes the five
free cells of the G1 family squares.** -/
theorem no_solution_le_1000 {m n : ℕ} (hn0 : 0 < n) (hn : n < m) (hm : m ≤ 1000)
    (hcop : Nat.Coprime m n) (hex : (m, n) ∉ exceptions1000) (t : ℚ) : ¬FullSquares m n t := by
  have h2 := pairOk_le_1000 hn hm
  unfold pairOk at h2
  have hg : (Nat.gcd m n == 1 && decide (0 < n)) = true := by
    rw [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq]
    exact ⟨hcop, hn0⟩
  simp only [hg, Bool.not_true, Bool.false_or, Bool.or_eq_true, decide_eq_true_eq] at h2
  rcases h2 with h2 | h2
  · exact no_solution_of_closed1000 h2 t
  · exact absurd h2 hex

end MagicSquareOfSquares.G1

namespace MagicSquareOfSquares

open G1

/-- **In a 3×3 magic square of squares with roots `a b c / d e f / g h i`, the ratio
`(b + d) : (h + f)` of the edge roots is not `m : n` for any coprime `1 ≤ n < m ≤ 1000` outside
the pairs of `G1.exceptions1000`.** -/
theorem IsMSS.ratio_ne_of_le_1000 {a b c d e f g h i T : ℤ} (hs : IsMSS a b c d e f g h i T)
    {m n : ℕ} (hn0 : 0 < n) (hnm : n < m) (hm : m ≤ 1000) (hcop : Nat.Coprime m n)
    (hex : (m, n) ∉ exceptions1000) (hne : h + f ≠ 0) (hbd : b ≠ d) :
    (b + d) * n ≠ (h + f) * m :=
  fun hmn => no_solution_le_1000 hn0 hnm hm hcop hex _ (hs.fullSquares hn0 hmn hne hbd)

end MagicSquareOfSquares
